---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import ComicStudio from '../islands/ComicStudio.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stages = [
  {
    num: '01' as const,
    label: t('comic.01.label'),
    en: t('comic.01.en'),
    title: t('comic.01.title'),
    desc: t('comic.01.desc'),
    meta: [t('comic.01.m1'), t('comic.01.m2'), t('comic.01.m3')] as string[],
  },
  {
    num: '02' as const,
    label: t('comic.02.label'),
    en: t('comic.02.en'),
    title: t('comic.02.title'),
    desc: t('comic.02.desc'),
    meta: [t('comic.02.m1'), t('comic.02.m2'), t('comic.02.m3')] as string[],
  },
  {
    num: '03' as const,
    label: t('comic.03.label'),
    en: t('comic.03.en'),
    title: t('comic.03.title'),
    desc: t('comic.03.desc'),
    meta: [t('comic.03.m1'), t('comic.03.m2'), t('comic.03.m3')] as string[],
  },
  {
    num: '04' as const,
    label: t('comic.04.label'),
    en: t('comic.04.en'),
    title: t('comic.04.title'),
    desc: t('comic.04.desc'),
    meta: [
      t('comic.04.m1'),
      t('comic.04.m2'),
      t('comic.04.m3'),
      t('comic.04.m4'),
    ] as string[],
  },
];
---

<section
  id="comic"
  class="relative mx-section overflow-hidden"
  style="padding: 160px 48px;"
>
  <div style="max-width: 1440px; margin: 0 auto;">
    <!-- Header — stacked single column -->
    <div class="mx-section-head" style="margin-bottom: 64px;">
      <div class="flex items-center gap-4 mb-7">
        <span class="num-tag">{t('comic.section')}</span>
        <span style="flex: 1; height: 1px; background: var(--bone-line);"
        ></span>
      </div>
      <h2
        class="h1-display comic-title"
        style="margin-bottom: 28px;"
        set:html={t('comic.title')}
      />
      <p class="body-lg-v2">
        {t('comic.subtitle')}
      </p>
    </div>

    <ComicStudio
      stages={stages}
      capabilitiesLabel="CAPABILITIES"
      client:visible
    />

    <div class="mx-comic-bottom flex justify-end items-center mt-6">
      <a
        href="https://mangacanvas.gamaniaocc.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-v2 btn-v2--primary mx-comic-cta"
      >
        <span class="mx-comic-cta-label">{t('comic.cta')}</span>
        <span class="arrow"></span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* All comic-section selectors live in this block. The block is global
     because most targets (.mx-comic-canvas, .mx-comic-tabs, .mx-comic-text,
     .mx-comic-mock, etc.) are rendered inside a React island and don't
     receive Astro's scoped data-cid attribute. The .mx-* / .comic-*
     namespacing keeps these from leaking into other sections. */

  /* Comic title: tighter clamp than the default h1-display so the long
     19-char Chinese title fits on one row at desktop / tablet widths. On
     narrow phones it will still wrap normally. */
  .comic-title {
    font-size: clamp(40px, 4.6vw, 68px) !important;
  }

  /* Bottom CTA — larger / heavier than the default btn-v2 sizing so it
     reads as the section's primary action. */
  @keyframes mx-comic-cta-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 1px rgba(255, 90, 31, 0.35),
        0 8px 28px rgba(255, 90, 31, 0.22);
      filter: brightness(1);
    }
    50% {
      box-shadow:
        0 0 0 3px rgba(255, 200, 140, 0.65),
        0 0 56px rgba(255, 90, 31, 0.72),
        0 14px 44px rgba(255, 90, 31, 0.42);
      filter: brightness(1.14);
    }
  }

  @keyframes mx-comic-cta-sheen {
    0% {
      transform: translateX(-120%) skewX(-18deg);
      opacity: 0;
    }
    12% {
      opacity: 0.85;
    }
    28% {
      transform: translateX(120%) skewX(-18deg);
      opacity: 0;
    }
    100% {
      transform: translateX(120%) skewX(-18deg);
      opacity: 0;
    }
  }

  .mx-comic-cta {
    position: relative;
    overflow: hidden;
    padding: 22px 36px !important;
    font-size: 14px !important;
    letter-spacing: 0.22em !important;
    box-shadow: 0 0 0 1px rgba(255, 90, 31, 0.0), 0 8px 24px rgba(255, 90, 31, 0.18);
    animation: mx-comic-cta-pulse 1.75s ease-in-out infinite;
    will-change: box-shadow, filter;
  }
  .mx-comic-cta::before {
    content: '';
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 58%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
    animation: mx-comic-cta-sheen 2.8s ease-in-out infinite;
  }
  .mx-comic-cta-label,
  .mx-comic-cta .arrow {
    position: relative;
    z-index: 1;
  }
  .mx-comic-cta:hover {
    animation-play-state: paused;
    filter: brightness(1);
    box-shadow: 0 0 0 1px rgba(255, 90, 31, 0.4), 0 12px 32px rgba(255, 90, 31, 0.28);
  }
  .mx-comic-cta:hover::before {
    animation-play-state: paused;
    opacity: 0;
  }
  .mx-comic-cta .arrow {
    width: 16px !important;
    height: 16px !important;
    border-top-width: 2px !important;
    border-right-width: 2px !important;
  }
  @container page (max-width: 700px) {
    .mx-comic-cta {
      padding: 18px 28px !important;
      font-size: 13px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-comic-cta {
      animation: none;
      will-change: auto;
    }
    .mx-comic-cta::before {
      animation: none;
      opacity: 0;
    }
  }

  /* ==============================================================
     Desktop default: all 4 stage panels are rendered, but only the
     one with .is-active is visible (controlled by React state).
     ============================================================== */
  .mx-comic-canvas {
    display: none !important;
  }
  .mx-comic-canvas.is-active {
    display: grid !important;
  }
  /* Mobile-only step badge stays hidden on desktop */
  .mx-comic-mobile-badge {
    display: none;
  }

  /* Tablet: 2x2 tabs, stack text-on-top / mock-below inside the active card */
  @container page (max-width: 900px) {
    .mx-comic-tabs {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .mx-comic-tabs button:nth-child(3) {
      border-left: none !important;
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-tabs button:nth-child(4) {
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-canvas.is-active {
      grid-template-columns: 1fr !important;
    }
    .mx-comic-canvas .mx-comic-text {
      border-right: none !important;
      border-bottom: 1px solid var(--bone-line) !important;
    }
  }

  /* ==============================================================
     Mobile: hide tabs, render all 4 stage panels stacked as cards.
     Each card = text block on top + mock below + thin separator.
     ============================================================== */
  @container page (max-width: 700px) {
    .mx-comic-tabs {
      display: none !important;
    }
    /* Show every stage panel, stacked */
    .mx-comic-canvas,
    .mx-comic-canvas.is-active {
      display: block !important;
      border-top: 1px solid var(--bone-line);
      margin-bottom: 16px;
      min-height: 0 !important;
    }
    .mx-comic-canvas:last-of-type {
      margin-bottom: 0;
    }
    /* Surface the small step badge that's hidden on desktop */
    .mx-comic-mobile-badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.25em;
      color: var(--color-cinnabar);
      padding: 4px 10px;
      border: 1px solid rgba(255, 90, 31, 0.4);
      background: rgba(255, 90, 31, 0.06);
      margin-bottom: 18px;
    }
    /* Text panel: tighter padding, drop the giant watermark */
    .mx-comic-text {
      padding: 28px 22px !important;
      border-right: none !important;
      border-bottom: 1px solid var(--bone-line) !important;
    }
    .mx-comic-text > div[aria-hidden] {
      display: none !important;
    }
    .mx-comic-stage-title {
      font-size: 30px !important;
      margin-bottom: 20px !important;
    }
    /* Mock panel: shorter height on phones, tighter inside padding */
    .mx-comic-mock {
      min-height: 380px !important;
    }
    /* Inner mock grids that were 3-col on desktop → 2-col so labels stay readable */
    .mx-comic-mock [data-mock-grid="3"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    /* Step 04: shrink the page-pile and reduce overlap so it fits a phone width */
    .mx-comic-mock [data-mock-page] {
      width: 60% !important;
      min-width: 160px !important;
    }
    .mx-comic-bottom {
      justify-content: center !important;
    }
  }
</style>
