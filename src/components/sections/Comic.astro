---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import ComicStudio from '../islands/ComicStudio.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stages = [
  {
    num: '01' as const,
    label: t('comic.01.label'),
    en: t('comic.01.en'),
    title: t('comic.01.title'),
    desc: t('comic.01.desc'),
    meta: [t('comic.01.m1'), t('comic.01.m2'), t('comic.01.m3')] as string[],
  },
  {
    num: '02' as const,
    label: t('comic.02.label'),
    en: t('comic.02.en'),
    title: t('comic.02.title'),
    desc: t('comic.02.desc'),
    meta: [t('comic.02.m1'), t('comic.02.m2'), t('comic.02.m3')] as string[],
  },
  {
    num: '03' as const,
    label: t('comic.03.label'),
    en: t('comic.03.en'),
    title: t('comic.03.title'),
    desc: t('comic.03.desc'),
    meta: [t('comic.03.m1'), t('comic.03.m2'), t('comic.03.m3')] as string[],
  },
  {
    num: '04' as const,
    label: t('comic.04.label'),
    en: t('comic.04.en'),
    title: t('comic.04.title'),
    desc: t('comic.04.desc'),
    meta: [
      t('comic.04.m1'),
      t('comic.04.m2'),
      t('comic.04.m3'),
      t('comic.04.m4'),
    ] as string[],
  },
];
---

<section
  id="comic"
  class="relative mx-section overflow-hidden"
  style="padding: 160px 48px;"
>
  <div style="max-width: 1440px; margin: 0 auto;">
    <!-- Header — stacked single column -->
    <div class="mx-section-head" style="margin-bottom: 64px;">
      <div class="flex items-center gap-4 mb-7">
        <span class="num-tag">{t('comic.section')}</span>
        <span style="flex: 1; height: 1px; background: var(--bone-line);"
        ></span>
      </div>
      <h2
        class="h1-display comic-title"
        style="margin-bottom: 28px;"
        set:html={t('comic.title')}
      />
      <p class="body-lg-v2">
        {t('comic.subtitle')}
      </p>
    </div>

    <ComicStudio
      stages={stages}
      capabilitiesLabel="CAPABILITIES"
      client:visible
    />

    <!-- Bottom flow strip -->
    <div
      class="mx-comic-bottom flex items-center mt-6"
      style="gap: 24px; padding: 22px 28px; border: 1px solid var(--bone-line);"
    >
      <span
        style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.25em; color: var(--color-cinnabar);"
      >
        {t('comic.flow')}
      </span>
      <span style="flex: 1; height: 1px; background: var(--bone-line);"></span>
      <span class="body-sm-v2" style="color: var(--color-bone-2);">
        {t('comic.flow.note')}
      </span>
      <a
        href="https://mangacanvas.gamaniaocc.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-v2 btn-v2--primary mx-comic-cta"
      >
        {t('comic.cta')}
        <span class="arrow"></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Comic title: tighter clamp than the default h1-display so the long
     19-char Chinese title fits on one row at desktop / tablet widths. On
     narrow phones it will still wrap normally. */
  .comic-title {
    font-size: clamp(40px, 4.6vw, 68px) !important;
  }

  /* Bottom CTA — larger / heavier than the default btn-v2 sizing so it
     reads as the section's primary action. */
  .mx-comic-cta {
    padding: 22px 36px !important;
    font-size: 14px !important;
    letter-spacing: 0.22em !important;
    box-shadow: 0 0 0 1px rgba(255, 90, 31, 0.0), 0 8px 24px rgba(255, 90, 31, 0.18);
  }
  .mx-comic-cta:hover {
    box-shadow: 0 0 0 1px rgba(255, 90, 31, 0.4), 0 12px 32px rgba(255, 90, 31, 0.28);
  }
  .mx-comic-cta .arrow {
    width: 16px !important;
    height: 16px !important;
    border-top-width: 2px !important;
    border-right-width: 2px !important;
  }
  @container page (max-width: 700px) {
    .mx-comic-cta {
      padding: 18px 28px !important;
      font-size: 13px !important;
    }
  }

  /* Tablet: 2x2 tabs, stacked canvas */
  @container page (max-width: 900px) {
    .mx-comic-tabs {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .mx-comic-tabs button:nth-child(3) {
      border-left: none !important;
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-tabs button:nth-child(4) {
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-canvas {
      grid-template-columns: 1fr !important;
    }
    .mx-comic-canvas > div:first-child {
      border-right: none !important;
      border-bottom: 1px solid var(--bone-line) !important;
    }
    .mx-comic-bottom {
      flex-wrap: wrap !important;
    }
  }

  /* Mobile: tabs collapse to a horizontally scrollable single-line strip */
  @container page (max-width: 600px) {
    .mx-comic-tabs {
      display: flex !important;
      grid-template-columns: none !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .mx-comic-tabs::-webkit-scrollbar {
      display: none;
    }
    .mx-comic-tabs button {
      flex: 0 0 auto;
      min-width: 60%;
      scroll-snap-align: start;
      padding: 16px 18px !important;
      border-left: 1px solid var(--bone-line) !important;
      border-top: none !important;
    }
    .mx-comic-tabs button:first-child {
      border-left: none !important;
    }
    /* Tighter mockup padding on mobile */
    .mx-comic-canvas {
      min-height: 0 !important;
    }
    .mx-comic-canvas > div:first-child {
      padding: 36px 28px !important;
    }
    .mx-comic-canvas > div:nth-child(2) {
      min-height: 440px !important;
    }
  }
</style>
