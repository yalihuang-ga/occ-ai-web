---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import ComicStudio from '../islands/ComicStudio.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stages = [
  {
    num: '01' as const,
    label: t('comic.01.label'),
    en: t('comic.01.en'),
    meta: [t('comic.01.m1'), t('comic.01.m2'), t('comic.01.m3'), t('comic.01.m4')] as string[],
  },
  {
    num: '02' as const,
    label: t('comic.02.label'),
    en: t('comic.02.en'),
    meta: [t('comic.02.m1'), t('comic.02.m2'), t('comic.02.m3')] as string[],
  },
  {
    num: '03' as const,
    label: t('comic.03.label'),
    en: t('comic.03.en'),
    meta: [t('comic.03.m1'), t('comic.03.m2'), t('comic.03.m3')] as string[],
  },
  {
    num: '04' as const,
    label: t('comic.04.label'),
    en: t('comic.04.en'),
    meta: [
      t('comic.04.m1'),
      t('comic.04.m2'),
      t('comic.04.m3'),
      t('comic.04.m4'),
    ] as string[],
  },
];
---

<section
  id="comic"
  class="relative mx-section overflow-hidden"
  style="padding: 160px 48px;"
>
  <div style="max-width: 1440px; margin: 0 auto;">
    <!-- Header — stacked single column -->
    <div class="mx-section-head" style="margin-bottom: 64px;">
      <div class="flex items-center gap-4 mb-7">
        <span class="num-tag">{t('comic.section')}</span>
        <span style="flex: 1; height: 1px; background: var(--bone-line);"
        ></span>
      </div>
      <h2
        class="h1-display comic-title"
        style="margin-bottom: 28px;"
        set:html={t('comic.title')}
      />
      <p class="body-lg-v2">
        {t('comic.subtitle')}
      </p>
    </div>

    <ComicStudio stages={stages} tagsAriaLabel={t('comic.tagsAria')} lang={lang} client:visible />

    <div class="mx-comic-bottom flex justify-end items-center mt-6">
      <a
        href="https://mangacanvas.gamaniaocc.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-v2 btn-v2--primary mx-comic-cta"
      >
        <span class="mx-comic-cta-label">{t('comic.cta')}</span>
        <span class="arrow"></span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* All comic-section selectors live in this block. The block is global
     because most targets (.mx-comic-canvas, .mx-comic-tabs, .mx-comic-mock,
     .mx-comic-tags-row, etc.) are rendered inside a React island and don't
     receive Astro's scoped data-cid attribute. The .mx-* / .comic-*
     namespacing keeps these from leaking into other sections. */

  /* Comic title: tighter clamp than the default h1-display so the long
     19-char Chinese title fits on one row at desktop / tablet widths. On
     narrow phones it will still wrap normally. */
  .comic-title {
    font-size: clamp(40px, 4.6vw, 68px) !important;
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Stage layout: mock full width, Solutions-style pills below (global .solution-tag) */
  .mx-comic-stage-inner {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .mx-comic-tags-row {
    padding: 22px 32px 26px;
    border-top: 1px solid var(--bone-line);
    background: var(--color-ink-2);
  }
  /* Match Solutions card tag hover when hovering the active stage */
  .mx-comic-canvas.is-active:hover .solution-tag {
    color: var(--color-bone);
    background: rgba(255, 90, 31, 0.16);
    border-color: rgba(255, 138, 90, 0.7);
  }
  .mx-comic-canvas.is-active:hover .solution-tag-dot {
    box-shadow: 0 0 10px rgba(255, 90, 31, 0.9);
  }

  /* Bottom CTA — larger / heavier than the default btn-v2 sizing so it
     reads as the section's primary action. */
  @keyframes mx-comic-cta-pulse {
    0%,
    100% {
      box-shadow:
        0 8px 28px rgba(255, 90, 31, 0.22),
        0 0 20px rgba(255, 90, 31, 0.12);
      filter: brightness(1);
    }
    50% {
      box-shadow:
        0 0 36px rgba(255, 90, 31, 0.38),
        0 14px 44px rgba(255, 90, 31, 0.36);
      filter: brightness(1.1);
    }
  }

  @keyframes mx-comic-cta-sheen {
    0% {
      transform: translateX(-120%) skewX(-18deg);
      opacity: 0;
    }
    12% {
      opacity: 0.85;
    }
    28% {
      transform: translateX(120%) skewX(-18deg);
      opacity: 0;
    }
    100% {
      transform: translateX(120%) skewX(-18deg);
      opacity: 0;
    }
  }

  .mx-comic-cta {
    position: relative;
    overflow: hidden;
    padding: 22px 36px !important;
    font-size: 14px !important;
    letter-spacing: 0.22em !important;
    box-shadow:
      0 8px 24px rgba(255, 90, 31, 0.18),
      0 0 18px rgba(255, 90, 31, 0.1);
    animation: mx-comic-cta-pulse 1.75s ease-in-out infinite;
    will-change: box-shadow, filter;
  }
  .mx-comic-cta::before {
    content: '';
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 42%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 58%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
    animation: mx-comic-cta-sheen 2.8s ease-in-out infinite;
  }
  .mx-comic-cta-label,
  .mx-comic-cta .arrow {
    position: relative;
    z-index: 1;
  }
  .mx-comic-cta:hover {
    animation-play-state: paused;
    filter: brightness(1);
    box-shadow:
      0 12px 32px rgba(255, 90, 31, 0.28),
      0 0 22px rgba(255, 90, 31, 0.18);
  }
  .mx-comic-cta:hover::before {
    animation-play-state: paused;
    opacity: 0;
  }
  .mx-comic-cta .arrow {
    width: 16px !important;
    height: 16px !important;
    border-top-width: 2px !important;
    border-right-width: 2px !important;
  }
  @container page (max-width: 700px) {
    .mx-comic-cta {
      padding: 18px 28px !important;
      font-size: 13px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-comic-cta {
      animation: none;
      will-change: auto;
    }
    .mx-comic-cta::before {
      animation: none;
      opacity: 0;
    }
  }

  /* ==============================================================
     Desktop: only the active stage panel is visible (React state).
     Panel = column: mock → tag row (full width).
     ============================================================== */
  .mx-comic-canvas {
    display: none !important;
  }
  .mx-comic-canvas.is-active {
    display: flex !important;
    flex-direction: column;
  }
  /* Mobile-only step header (badge + title) — hidden on desktop */
  .mx-comic-mobile-header {
    display: none;
  }
  .mx-comic-mobile-badge {
    display: none;
  }
  .mx-comic-mobile-title {
    display: none;
  }

  /* Tablet: 2x2 tabs; stage panel stays single column (mock → tags) */
  @container page (max-width: 900px) {
    .mx-comic-tabs {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .mx-comic-tabs button:nth-child(3) {
      border-left: none !important;
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-tabs button:nth-child(4) {
      border-top: 1px solid var(--bone-line) !important;
    }
    .mx-comic-tags-row {
      padding: 18px 24px 22px;
    }
  }

  /* ==============================================================
     Mobile: hide tabs; stack all 4 stages (badge → mock → tags).
     ============================================================== */
  @container page (max-width: 700px) {
    .mx-comic-tabs {
      display: none !important;
    }
    .mx-comic-canvas,
    .mx-comic-canvas.is-active {
      display: flex !important;
      flex-direction: column;
      border-top: 1px solid var(--bone-line);
      margin-bottom: 16px;
      min-height: 0 !important;
    }
    .mx-comic-canvas:last-of-type {
      margin-bottom: 0;
    }
    .mx-comic-stage-inner {
      padding: 16px 0 0;
    }
    .mx-comic-mobile-header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 18px 12px;
    }
    .mx-comic-mobile-badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.25em;
      color: var(--color-cinnabar);
      padding: 4px 10px;
      border: 1px solid rgba(255, 90, 31, 0.4);
      background: rgba(255, 90, 31, 0.06);
    }
    .mx-comic-mobile-title {
      display: block;
      font-family: var(--font-headline);
      font-size: 20px;
      font-weight: 500;
      color: var(--color-bone);
      letter-spacing: -0.01em;
    }
    .mx-comic-tags-row {
      padding: 14px 18px 18px;
    }
    /* Mock panel: shorter height on phones, tighter inside padding */
    .mx-comic-mock {
      min-height: 0 !important;
    }
    /* Inner mock grids that were 3-col on desktop → 2-col so labels stay readable */
    .mx-comic-mock [data-mock-grid="3"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    /* Step 04: shrink the page-pile and reduce overlap so it fits a phone width */
    .mx-comic-mock [data-mock-page] {
      width: 60% !important;
      min-width: 160px !important;
    }
    .mx-comic-bottom {
      justify-content: center !important;
    }
  }
</style>
