---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

import { ChatMock, ChatMockB, StoryProgress, CharacterCard, SceneCard, StoryboardAssemble, StoryboardEdit, PublishStack } from '../islands/ComicFlowVisuals.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-comic-flow">
  <!-- Hero intro -->
  <div class="cf-hero">
    <span class="cf-eyebrow">AI COMIC STUDIO</span>
    <h1 class="h1-display" style="color: var(--color-bone);" set:html={t('comic.title')} />
    <h2 class="cf-hero-desc">
      {t('comic.subtitle')}
    </h2>

    <!-- Productivity badges -->
    <div class="cf-hero-badges">
      <div class="cf-hero-badge">
        <div class="cf-badge-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
        </div>
        <h3 class="cf-hero-badge-value">{lang === 'en' ? 'Speed up 20×' : lang === 'ja' ? '20倍高速化' : '加速 20 倍'}</h3>
        <p class="cf-hero-badge-desc">{lang === 'en' ? 'From concept to finished pages in hours, not months.' : lang === 'ja' ? '構想から完成まで、数ヶ月ではなく数時間で。' : '從構想到成品，以小時計而非月計。'}</p>
      </div>
      <div class="cf-hero-badge">
        <div class="cf-badge-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
        </div>
        <h3 class="cf-hero-badge-value">{lang === 'en' ? 'Consistent style' : lang === 'ja' ? 'スタイル統一' : '風格一致'}</h3>
        <p class="cf-hero-badge-desc">{lang === 'en' ? 'Characters stay on-model across every panel and chapter.' : lang === 'ja' ? 'キャラは全コマ・全話で統一されます。' : '角色跨分鏡、跨章節維持一致外觀。'}</p>
      </div>
      <div class="cf-hero-badge">
        <div class="cf-badge-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L2 7 L12 12 L22 7 Z" /><path d="M2 17 L12 22 L22 17" /><path d="M2 12 L12 17 L22 12" /></svg>
        </div>
        <h3 class="cf-hero-badge-value">{lang === 'en' ? 'All-in-one' : lang === 'ja' ? 'オールインワン' : '一站式作業'}</h3>
        <p class="cf-hero-badge-desc">{lang === 'en' ? 'Script, art, layout, and publish — one integrated workflow.' : lang === 'ja' ? '脚本・作画・レイアウト・公開を一つのワークフローで。' : '劇本、作畫、排版、發布一站完成。'}</p>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="cf-hero-scroll" aria-hidden="true">
      <span class="cf-hero-scroll-label">SCROLL</span>
      <span class="cf-hero-scroll-line">
        <span class="cf-hero-scroll-dot"></span>
      </span>
    </div>
  </div>

  <!-- Step 1: Story Planning -->
  <div class="cf-step" data-step="1">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">01</span>
        <h2 class="cf-step-title">{t('comic.01.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Describe your story inspiration in one sentence — AI screenwriter helps you clarify the direction.' : lang === 'ja' ? '一言でストーリーのインスピレーションを伝えると、AI脚本家が方向性を整理します。' : '一句話說明你的故事靈感，AI 編劇會陪你釐清方向。'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'After selecting a theme, AI digs deeper to confirm style and length.' : lang === 'ja' ? 'テーマ選定後、AIがスタイルと長さを確認します。' : '選定主題後，AI 會繼續深入提問，確認風格與篇幅。'}
        </li>
        <li class="cf-flow-item" data-flow="2">
          {lang === 'en' ? 'Discussion complete — AI begins crafting the entire work.' : lang === 'ja' ? '討論完了——AIが作品全体の構想を開始します。' : '討論完成，AI 開始構思整部作品。'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m3')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m4')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Describe your story inspiration in one sentence — AI screenwriter helps you clarify the direction.' : lang === 'ja' ? '一言でストーリーのインスピレーションを伝えると、AI脚本家が方向性を整理します。' : '一句話說明你的故事靈感，AI 編劇會陪你釐清方向。'}</p>
          <ChatMock lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'After selecting a theme, AI digs deeper to confirm style and length.' : lang === 'ja' ? 'テーマ選定後、AIがスタイルと長さを確認します。' : '選定主題後，AI 會繼續深入提問，確認風格與篇幅。'}</p>
          <ChatMockB lang={lang} client:visible />
        </div>
        <div data-flow-idx="2">
          <p class="cf-flow-label">{lang === 'en' ? 'Discussion complete — AI begins crafting the entire work.' : lang === 'ja' ? '討論完了——AIが作品全体の構想を開始します。' : '討論完成，AI 開始構思整部作品。'}</p>
          <StoryProgress lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Character & Scene -->
  <div class="cf-step" data-step="2">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">02</span>
        <h2 class="cf-step-title">{t('comic.02.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Generate character turnaround sheets' : lang === 'ja' ? 'キャラクター三面図を生成' : '生成角色三視圖'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'Auto-generate story scene artwork' : lang === 'ja' ? 'ストーリーシーン画を自動生成' : '自動產生故事場景圖素'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.02.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.02.m3')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Generate character turnaround sheets' : lang === 'ja' ? 'キャラクター三面図を生成' : '生成角色三視圖'}</p>
          <CharacterCard lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'Auto-generate story scene artwork' : lang === 'ja' ? 'ストーリーシーン画を自動生成' : '自動產生故事場景圖素'}</p>
          <SceneCard lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Storyboard -->
  <div class="cf-step" data-step="3">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">03</span>
        <h2 class="cf-step-title">{t('comic.03.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Batch-generate all storyboard panels' : lang === 'ja' ? '全コマを一括生成' : '批次生成所有分鏡'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'Manually edit panel artwork' : lang === 'ja' ? 'コマ画像を手動編集' : '手動修改分鏡圖'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.03.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.03.m3')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Batch-generate all storyboard panels' : lang === 'ja' ? '全コマを一括生成' : '批次生成所有分鏡'}</p>
          <StoryboardAssemble lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'Manually edit panel artwork' : lang === 'ja' ? 'コマ画像を手動編集' : '手動修改分鏡圖'}</p>
          <StoryboardEdit lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 4: Publish -->
  <div class="cf-step" data-step="4">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">04</span>
        <h2 class="cf-step-title">{t('comic.04.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {t('comic.04.m1')}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m3')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m4')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{t('comic.04.m1')}</p>
          <PublishStack lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="cf-cta">
    <a
      href="https://mangacanvas.gamaniaocc.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="cf-cta-btn"
    >
      {t('comic.cta')}
    </a>
  </div>
</section>

<script>
  document.querySelectorAll('.cf-step').forEach(step => {
    const cards = step.querySelectorAll('[data-flow-idx]');
    const flowItems = step.querySelectorAll('.cf-flow-item');

    if (!cards.length || !flowItems.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = (entry.target as HTMLElement).dataset.flowIdx;
          flowItems.forEach((item, i) => {
            item.classList.toggle('cf-flow-item--active', i === Number(idx));
          });
        }
      });
    }, { threshold: 0.3, rootMargin: '-20% 0px -40% 0px' });

    cards.forEach(card => observer.observe(card));
  });
</script>

<style is:global>
  /* ===== Layout ===== */
  .mx-comic-flow {
    padding: 160px 48px 120px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .cf-hero {
    text-align: center;
    margin-bottom: 120px;
  }
  .cf-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
    display: block;
    margin-bottom: 32px;
  }

  .cf-hero .h1-display {
    margin-bottom: 24px;
  }

  .cf-hero-desc {
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-bone-2);
    max-width: 100%;
    margin: 0 auto;
  }

  /* Productivity badges — large card style */
  .cf-hero-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 56px;
  }
  .cf-hero-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 28px;
    border: 1px solid var(--bone-line);
    border-radius: 16px;
    background: rgba(244, 236, 220, 0.02);
    text-align: center;
    color: var(--color-bone);
  }
  .cf-badge-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(255, 90, 31, 0.08);
    border: 1px solid rgba(255, 90, 31, 0.2);
  }
  .cf-badge-icon svg {
    color: var(--color-cinnabar);
  }
  .cf-hero-badge-value {
    font-family: var(--font-headline);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .cf-hero-badge-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-bone-3);
    margin: 0;
  }

  /* Scroll indicator (matches homepage) */
  .cf-hero-scroll {
    margin-top: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    pointer-events: none;
  }
  .cf-hero-scroll-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.4em;
    color: rgba(244, 236, 220, 0.55);
    text-transform: uppercase;
  }
  .cf-hero-scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(244, 236, 220, 0.25) 0%, transparent 100%);
    overflow: visible;
  }
  .cf-hero-scroll-dot {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 1px;
    height: 14px;
    transform: translateX(-50%);
    background: #ff5a1f;
    box-shadow: 0 0 6px rgba(255, 90, 31, 0.7), 0 0 14px rgba(255, 90, 31, 0.35);
    animation: cfScrollDot 2.2s cubic-bezier(0.55, 0.05, 0.45, 0.95) infinite;
  }
  @keyframes cfScrollDot {
    0% { top: -14px; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { top: 56px; opacity: 0; }
  }

  .cf-step {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    min-height: auto;
    padding: 80px 0;
    border-top: 1px solid var(--bone-line);
    align-items: start;
  }
  .cf-step[data-step="4"] {
    min-height: auto;
  }

  .cf-left {
    position: sticky;
    top: 30vh;
    align-self: start;
  }
  .cf-step-num {
    font-family: var(--font-headline);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 500;
    color: var(--color-cinnabar);
    letter-spacing: -0.02em;
  }
  .cf-step-title {
    font-family: var(--font-headline);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 500;
    color: var(--color-bone);
    margin: 0;
  }
  .cf-step-title-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }

  /* Flow list (all steps left column) */
  .cf-flow-list {
    list-style: none;
    padding: 0;
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: flow;
  }
  .cf-flow-item {
    counter-increment: flow;
    padding: 14px 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-bone);
    border-left: 2px solid transparent;
    transition: all 0.4s ease;
    opacity: 1;
  }
  .cf-flow-item--active {
    color: var(--color-bone);
    border-left-color: var(--color-cinnabar);
    opacity: 1;
    background: rgba(255, 90, 31, 0.04);
  }

  /* Flow labels (mobile only — hidden on desktop) */
  .cf-flow-label {
    display: none;
  }

  /* Tags */
  .cf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .cf-right {
    display: flex;
    align-items: flex-start;
  }
  .cf-right-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Narration text between cards */
  .cf-narration {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-bone-2);
    padding: 48px 0;
    margin: 0;
  }

  .cf-cta {
    text-align: center;
    padding: 80px 0 0;
  }
  .cf-cta-btn {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 14px 40px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    border-radius: 12px;
    border: none;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #ff5a00 0%, #ff7a30 100%);
    color: #fff;
    box-shadow: 0 0 28px rgba(255, 90, 0, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cf-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 50px rgba(255, 90, 0, 0.65);
  }
  .cf-cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    animation: cfShimmer 2.5s infinite;
  }
  @keyframes cfShimmer {
    0% { left: -100%; }
    100% { left: 200%; }
  }

  /* ===== Shared elements ===== */
  .cf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cinnabar);
    flex-shrink: 0;
  }
  .cf-line {
    flex: 1;
    height: 1px;
    background: var(--bone-line);
  }
  .cf-mono-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-bone-2);
  }

  /* ===== Visual card base ===== */
  .cf-visual {
    width: 100%;
    background: var(--color-ink-2);
    border: 1px solid var(--bone-line);
    border-radius: 4px;
    overflow: hidden;
  }
  .cf-visual--pending {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cf-visual--ready {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* ===== Step 1: Chat ===== */
  .cf-chat {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 520px;
    position: relative;
    overflow: hidden;
  }

  /* Enlarged user-input intro overlay */
  .cf-intro-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    background: rgba(20, 18, 15, 0.95);
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.6s ease, transform 0.6s ease;
    padding: 40px;
  }
  .cf-intro-overlay.cf-in {
    opacity: 1;
    transform: scale(1);
  }
  .cf-intro-overlay.cf-intro-shrunk {
    opacity: 0;
    transform: scale(0.7) translateY(-20px);
    pointer-events: none;
  }
  .cf-intro-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 90%;
    max-width: 560px;
  }
  .cf-intro-input-wrap {
    width: 90%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: stretch;
  }
  .cf-intro-input {
    padding: 18px 22px;
    background: var(--color-ink);
    border: 1px solid var(--bone-line);
    border-radius: 10px;
    font-size: clamp(16px, 2.2vw, 20px);
    line-height: 1.7;
    color: var(--color-bone);
    min-height: 60px;
    position: relative;
  }
  .cf-intro-typed {
    font-weight: 500;
  }
  .cf-intro-cursor {
    display: inline-block;
    width: 2px;
    height: 1.2em;
    background: var(--color-cinnabar);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: cfBlink 1s step-end infinite;
  }
  .cf-intro-send-btn {
    align-self: flex-end;
    padding: 10px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-cinnabar);
    background: transparent;
    border: 1px solid var(--color-cinnabar);
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.3s ease;
  }
  .cf-intro-send-btn--show {
    opacity: 1;
    transform: translateY(0);
  }
  .cf-intro-send-btn--active {
    background: var(--color-cinnabar);
    color: var(--color-bone);
    box-shadow: 0 0 24px rgba(255, 90, 31, 0.4);
