---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

import { ChatMock, ChatMockB, StoryProgress, CharacterCard, SceneCard, StoryboardAssemble, StoryboardEdit, PublishStack } from '../islands/ComicFlowVisuals.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-comic-flow">
  <!-- Hero intro -->
  <div class="cf-hero">
    <span class="cf-eyebrow">AI COMIC STUDIO</span>
    <h1 class="h1-display" style="color: var(--color-bone); margin-bottom: 24px;" set:html={t('comic.title')} />
    <p class="body-lg-v2" style="max-width: 560px; margin: 0 auto;">
      {t('comic.subtitle')}
    </p>
  </div>

  <!-- Step 1: Story Planning -->
  <div class="cf-step" data-step="1">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">01</span>
        <h2 class="cf-step-title">{t('comic.01.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Describe your story inspiration in one sentence — AI screenwriter helps you clarify the direction.' : lang === 'ja' ? '一言でストーリーのインスピレーションを伝えると、AI脚本家が方向性を整理します。' : '一句話說明你的故事靈感，AI 編劇會陪你釐清方向。'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'After selecting a theme, AI digs deeper to confirm style and length.' : lang === 'ja' ? 'テーマ選定後、AIがスタイルと長さを確認します。' : '選定主題後，AI 會繼續深入提問，確認風格與篇幅。'}
        </li>
        <li class="cf-flow-item" data-flow="2">
          {lang === 'en' ? 'Discussion complete — AI begins crafting the entire work.' : lang === 'ja' ? '討論完了——AIが作品全体の構想を開始します。' : '討論完成，AI 開始構思整部作品。'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m3')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.01.m4')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Describe your story inspiration in one sentence — AI screenwriter helps you clarify the direction.' : lang === 'ja' ? '一言でストーリーのインスピレーションを伝えると、AI脚本家が方向性を整理します。' : '一句話說明你的故事靈感，AI 編劇會陪你釐清方向。'}</p>
          <ChatMock lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'After selecting a theme, AI digs deeper to confirm style and length.' : lang === 'ja' ? 'テーマ選定後、AIがスタイルと長さを確認します。' : '選定主題後，AI 會繼續深入提問，確認風格與篇幅。'}</p>
          <ChatMockB lang={lang} client:visible />
        </div>
        <div data-flow-idx="2">
          <p class="cf-flow-label">{lang === 'en' ? 'Discussion complete — AI begins crafting the entire work.' : lang === 'ja' ? '討論完了——AIが作品全体の構想を開始します。' : '討論完成，AI 開始構思整部作品。'}</p>
          <StoryProgress lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Character & Scene -->
  <div class="cf-step" data-step="2">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">02</span>
        <h2 class="cf-step-title">{t('comic.02.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Generate character turnaround sheets' : lang === 'ja' ? 'キャラクター三面図を生成' : '生成角色三視圖'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'Auto-generate story scene artwork' : lang === 'ja' ? 'ストーリーシーン画を自動生成' : '自動產生故事場景圖素'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.02.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.02.m3')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Generate character turnaround sheets' : lang === 'ja' ? 'キャラクター三面図を生成' : '生成角色三視圖'}</p>
          <CharacterCard lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'Auto-generate story scene artwork' : lang === 'ja' ? 'ストーリーシーン画を自動生成' : '自動產生故事場景圖素'}</p>
          <SceneCard lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Storyboard -->
  <div class="cf-step" data-step="3">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">03</span>
        <h2 class="cf-step-title">{t('comic.03.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {lang === 'en' ? 'Batch-generate all storyboard panels' : lang === 'ja' ? '全コマを一括生成' : '批次生成所有分鏡'}
        </li>
        <li class="cf-flow-item" data-flow="1">
          {lang === 'en' ? 'Manually edit panel artwork' : lang === 'ja' ? 'コマ画像を手動編集' : '手動修改分鏡圖'}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.03.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.03.m3')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{lang === 'en' ? 'Batch-generate all storyboard panels' : lang === 'ja' ? '全コマを一括生成' : '批次生成所有分鏡'}</p>
          <StoryboardAssemble lang={lang} client:visible />
        </div>
        <div data-flow-idx="1">
          <p class="cf-flow-label">{lang === 'en' ? 'Manually edit panel artwork' : lang === 'ja' ? 'コマ画像を手動編集' : '手動修改分鏡圖'}</p>
          <StoryboardEdit lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Step 4: Publish -->
  <div class="cf-step" data-step="4">
    <div class="cf-left">
      <div class="cf-step-title-row">
        <span class="cf-step-num">04</span>
        <h2 class="cf-step-title">{t('comic.04.label')}</h2>
      </div>
      <ol class="cf-flow-list">
        <li class="cf-flow-item cf-flow-item--active" data-flow="0">
          {t('comic.04.m1')}
        </li>
      </ol>
      <div class="cf-tags">
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m2')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m3')}</span>
        <span class="solution-tag"><span class="solution-tag-dot" />{t('comic.04.m4')}</span>
      </div>
    </div>
    <div class="cf-right">
      <div class="cf-right-stack">
        <div data-flow-idx="0">
          <p class="cf-flow-label">{t('comic.04.m1')}</p>
          <PublishStack lang={lang} client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="cf-cta">
    <a
      href="https://mangacanvas.gamaniaocc.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="shimmer-btn shimmer-btn-primary"
      style="padding: 24px 40px; font-size: 15px;"
    >
      {t('comic.cta')}
    </a>
  </div>
</section>

<script>
  document.querySelectorAll('.cf-step').forEach(step => {
    const cards = step.querySelectorAll('[data-flow-idx]');
    const flowItems = step.querySelectorAll('.cf-flow-item');

    if (!cards.length || !flowItems.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = (entry.target as HTMLElement).dataset.flowIdx;
          flowItems.forEach((item, i) => {
            item.classList.toggle('cf-flow-item--active', i === Number(idx));
          });
        }
      });
    }, { threshold: 0.3, rootMargin: '-20% 0px -40% 0px' });

    cards.forEach(card => observer.observe(card));
  });
</script>

<style is:global>
  /* ===== Layout ===== */
  .mx-comic-flow {
    padding: 160px 48px 100px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .cf-hero {
    text-align: center;
    margin-bottom: 120px;
  }
  .cf-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
    display: block;
    margin-bottom: 20px;
  }

  .cf-step {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    min-height: 100vh;
    padding: 80px 0;
    border-top: 1px solid var(--bone-line);
    align-items: start;
  }

  .cf-left {
    position: sticky;
    top: 30vh;
    align-self: start;
  }
  .cf-step-num {
    font-family: var(--font-headline);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 500;
    color: var(--color-cinnabar);
    letter-spacing: -0.02em;
  }
  .cf-step-title {
    font-family: var(--font-headline);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 500;
    color: var(--color-bone);
    margin: 0;
  }
  .cf-step-title-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }

  /* Flow list (all steps left column) */
  .cf-flow-list {
    list-style: none;
    padding: 0;
    margin: 20px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: flow;
  }
  .cf-flow-item {
    counter-increment: flow;
    padding: 14px 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-bone);
    border-left: 2px solid transparent;
    transition: all 0.4s ease;
    opacity: 1;
  }
  .cf-flow-item--active {
    color: var(--color-bone);
    border-left-color: var(--color-cinnabar);
    opacity: 1;
    background: rgba(255, 90, 31, 0.04);
  }

  /* Flow labels (mobile only — hidden on desktop) */
  .cf-flow-label {
    display: none;
  }

  /* Tags */
  .cf-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .cf-right {
    display: flex;
    align-items: flex-start;
  }
  .cf-right-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Narration text between cards */
  .cf-narration {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-bone-2);
    padding: 48px 0;
    margin: 0;
  }

  .cf-cta {
    text-align: center;
    padding: 100px 0 0;
  }

  /* ===== Shared elements ===== */
  .cf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cinnabar);
    flex-shrink: 0;
  }
  .cf-line {
    flex: 1;
    height: 1px;
    background: var(--bone-line);
  }
  .cf-mono-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-bone-2);
  }

  /* ===== Visual card base ===== */
  .cf-visual {
    width: 100%;
    background: var(--color-ink-2);
    border: 1px solid var(--bone-line);
    border-radius: 4px;
    overflow: hidden;
  }
  .cf-visual--pending {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cf-visual--ready {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* ===== Step 1: Chat ===== */
  .cf-chat {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 520px;
    position: relative;
    overflow: hidden;
  }

  /* Enlarged user-input intro overlay */
  .cf-intro-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    background: rgba(20, 18, 15, 0.95);
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.6s ease, transform 0.6s ease;
    padding: 40px;
  }
  .cf-intro-overlay.cf-in {
    opacity: 1;
    transform: scale(1);
  }
  .cf-intro-overlay.cf-intro-shrunk {
    opacity: 0;
    transform: scale(0.7) translateY(-20px);
    pointer-events: none;
  }
  .cf-intro-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 90%;
    max-width: 560px;
  }
  .cf-intro-input-wrap {
    width: 90%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: stretch;
  }
  .cf-intro-input {
    padding: 18px 22px;
    background: var(--color-ink);
    border: 1px solid var(--bone-line);
    border-radius: 10px;
    font-size: clamp(16px, 2.2vw, 20px);
    line-height: 1.7;
    color: var(--color-bone);
    min-height: 60px;
    position: relative;
  }
  .cf-intro-typed {
    font-weight: 500;
  }
  .cf-intro-cursor {
    display: inline-block;
    width: 2px;
    height: 1.2em;
    background: var(--color-cinnabar);
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: cfBlink 1s step-end infinite;
  }
  .cf-intro-send-btn {
    align-self: flex-end;
    padding: 10px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-cinnabar);
    background: transparent;
    border: 1px solid var(--color-cinnabar);
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.3s ease;
  }
  .cf-intro-send-btn--show {
    opacity: 1;
    transform: translateY(0);
  }
  .cf-intro-send-btn--active {
    background: var(--color-cinnabar);
    color: var(--color-bone);
    box-shadow: 0 0 24px rgba(255, 90, 31, 0.4);
    transform: scale(0.96);
  }
  .cf-intro-text {
    font-size: clamp(18px, 2.5vw, 22px);
    line-height: 1.7;
    color: var(--color-bone);
    text-align: center;
    font-weight: 500;
    padding: 20px 28px;
    background: var(--color-cinnabar);
    border-radius: 12px;
    box-shadow: 0 0 40px rgba(255, 90, 31, 0.2);
  }
  .cf-intro-send {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-bone);
    background: rgba(255, 90, 31, 0.15);
    border: 1px solid var(--color-cinnabar);
    border-radius: 8px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease, background 0.3s ease, box-shadow 0.3s ease;
  }
  .cf-intro-send--visible {
    opacity: 1;
    transform: translateY(0);
  }
  .cf-intro-send--clicked {
    background: var(--color-cinnabar);
    box-shadow: 0 0 20px rgba(255, 90, 31, 0.5);
    transform: scale(0.95);
  }

  /* Chat body visibility */
  .cf-chat-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.6s ease 0.3s;
  }
  .cf-chat-body--visible {
    opacity: 1;
  }
  .cf-chat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .cf-msg {
    display: flex;
    gap: 10px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .cf-msg.cf-in {
    opacity: 1;
    transform: translateY(0);
  }
  .cf-msg--user { justify-content: flex-end; }
  .cf-msg--ai { align-items: flex-start; }
  .cf-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-cinnabar);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--color-bone);
    flex-shrink: 0;
  }
  .cf-bubble {
    padding: 12px 16px;
    font-size: 12px;
    line-height: 1.7;
    max-width: 80%;
  }
  .cf-bubble--user {
    background: var(--color-cinnabar);
    color: var(--color-bone);
  }
  .cf-bubble--ai {
    background: rgba(244, 236, 220, 0.04);
    border: 1px solid var(--bone-line);
    color: var(--color-bone);
  }
  .cf-bubble--ai p { margin: 0 0 10px; }
  .cf-options {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .cf-option {
    font-size: 11px;
    padding: 6px 12px;
    border: 1px solid var(--bone-line);
    color: var(--color-bone-3);
    background: var(--color-ink-2);
    transition: border-color 0.3s, color 0.3s;
  }
  .cf-option--active {
    border-color: var(--color-cinnabar);
    color: var(--color-cinnabar);
  }
  .cf-typing {
    display: flex !important;
    gap: 4px;
    padding: 14px 18px !important;
  }
  .cf-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-bone-3);
    animation: cfTyping 1.4s infinite;
  }
  .cf-typing span:nth-child(2) { animation-delay: 0.2s; }
  .cf-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes cfTyping {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }
  .cf-input {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--bone-line);
    background: var(--color-ink);
    margin-top: auto;
    gap: 4px;
  }
  .cf-input-text {
    flex: 1;
    font-size: 12px;
    color: var(--color-bone-3);
  }
  .cf-input-cursor {
    width: 1px;
    height: 14px;
    background: var(--color-cinnabar);
    animation: cfBlink 1s step-end infinite;
  }
  @keyframes cfBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .cf-input-send {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--color-cinnabar);
    margin-left: 12px;
  }

  /* ===== Step 2: Character & Scene ===== */
  .cf-gen {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .cf-gen-section { display: flex; flex-direction: column; gap: 12px; }
  .cf-gen-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cf-gen-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--color-cinnabar);
    animation: cfPulse 2s infinite;
  }
  @keyframes cfPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Blur-to-clear reveal */
  .cf-reveal {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--bone-line);
    border-radius: 2px;
  }
  .cf-reveal img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(20px) saturate(0.5);
    transform: scale(1.05);
    transition: filter 1.6s cubic-bezier(0.22, 1, 0.36, 1), transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-visible .cf-reveal img {
    filter: blur(0) saturate(1);
    transform: scale(1);
  }

  .cf-gen-img-wrap {
    aspect-ratio: 900 / 500;
  }

  .cf-scan-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-cinnabar), transparent);
    animation: cfScan 3s linear infinite;
    opacity: 0;
  }
  .is-visible .cf-scan-line { opacity: 1; }
  @keyframes cfScan {
    0% { top: 0%; }
    100% { top: 100%; }
  }

  .cf-scene-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .cf-scene-grid--full {
    aspect-ratio: 900 / 500;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--bone-line);
    border-radius: 2px;
  }
  .cf-scene-item {
    aspect-ratio: auto;
    min-height: 0;
  }
