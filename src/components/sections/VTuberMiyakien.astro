---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const TWITCH_URL = 'https://www.twitch.tv/miyakien';
const IG_URL = 'https://www.instagram.com/miyakien0428/';

const abilities = [
  { key: 'live', tag: 'LIVE', title: t('vh.vtuber.live.title'), body: t('vh.vtuber.live.body') },
  { key: 'perform', tag: 'SING · DANCE', title: t('vh.vtuber.perform.title'), body: t('vh.vtuber.perform.body') },
  { key: 'game', tag: 'GAMING', title: t('vh.vtuber.game.title'), body: t('vh.vtuber.game.body') },
  { key: 'social', tag: 'SOCIAL · TRENDS', title: t('vh.vtuber.social.title'), body: t('vh.vtuber.social.body') },
];
---

<section id="vtuber" class="vt" aria-labelledby="vt-title">
  <div class="vt-bg" aria-hidden="true">
    <div class="vt-bg__glow vt-bg__glow--a"></div>
    <div class="vt-bg__glow vt-bg__glow--b"></div>
  </div>

  <div class="vt-container">
    {/* Transition from the technology story into our own AI VTuber. */}
    <div class="vt-bridge">
      <span class="vt-eyebrow">{t('vh.vtuber.bridge.eyebrow')}</span>
      <p class="vt-bridge__title" set:html={t('vh.vtuber.bridge.title')} />
      <p class="vt-bridge__body">{t('vh.vtuber.bridge.body')}</p>
      <span class="vt-bridge__line" aria-hidden="true"></span>
    </div>

    <div class="vt-main">
      <figure class="vt-visual">
        <div class="vt-visual__halo" aria-hidden="true"></div>
        <img
          class="vt-visual__img"
          src="/images/miyakien-vtuber.webp"
          alt={t('vh.vtuber.image.alt')}
          width="720"
          height="1008"
          loading="lazy"
          decoding="async"
        />
        <span class="vt-visual__live" aria-hidden="true">
          <span class="vt-visual__dot"></span>LIVE
        </span>
      </figure>

      <div class="vt-copy">
        <span class="vt-eyebrow">{t('vh.vtuber.eyebrow')}</span>
        <h2 id="vt-title" class="h1-display vt-title" set:html={t('vh.vtuber.title')} />
        <p class="vt-subtitle">{t('vh.vtuber.subtitle')}</p>

        <ul class="vt-abilities" role="list">
          {abilities.map((a) => (
            <li class={`vt-ability vt-ability--${a.key}`}>
              <span class="vt-ability__tag">{a.tag}</span>
              <h3 class="vt-ability__title">{a.title}</h3>
              <p class="vt-ability__body">{a.body}</p>
            </li>
          ))}
        </ul>

        <div class="vt-cta">
          <a class="btn-v2 btn-v2--primary vt-cta__btn" href={TWITCH_URL} target="_blank" rel="noopener noreferrer">
            <svg class="vt-cta__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M4.3 2 3 5.4v13.8h4.7V22h2.6l2.7-2.8h3.8L22 14V2H4.3Zm15.9 11.1-3 3h-4.7L9.8 18.8v-2.7H5.9V3.8h14.3v9.3Zm-3-6.1v5.2h-1.8V7h1.8Zm-4.8 0v5.2h-1.8V7h1.8Z"/>
            </svg>
            {t('vh.vtuber.cta.twitch')}
          </a>
          <a class="btn-v2 btn-v2--ghost vt-cta__btn" href={IG_URL} target="_blank" rel="noopener noreferrer">
            <svg class="vt-cta__icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/>
            </svg>
            {t('vh.vtuber.cta.ig')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vt {
    position: relative;
    padding: 40px 24px 140px;
    /* Starts on HowWarmAI's ink so the two sections read as one continuous scroll. */
    background: linear-gradient(180deg, #0e0b08 0%, #0c0a08 30%);
    color: var(--color-bone);
    overflow: hidden;
    isolation: isolate;
  }

  .vt-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .vt-bg__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
  }

  .vt-bg__glow--a {
    width: 640px;
    height: 640px;
    left: -8%;
    top: 10%;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.16), transparent 62%);
  }

  .vt-bg__glow--b {
    width: 520px;
    height: 520px;
    right: -6%;
    bottom: -10%;
    background: radial-gradient(circle, rgba(217, 184, 114, 0.1), transparent 62%);
  }

  .vt-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ---------- Bridge (transition) ---------- */
  .vt-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    margin: 0 auto 72px;
    text-align: center;
  }

  .vt-bridge__title {
    font-family: var(--font-headline);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-bone);
    margin: 0 0 20px;
  }

  .vt-bridge__body {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.75;
    color: var(--color-bone-2);
    max-width: 620px;
    margin: 0;
  }

  /* A fading line with a glowing dot that leads the eye down to her. */
  .vt-bridge__line {
    position: relative;
    display: block;
    width: 1px;
    height: 96px;
    margin-top: 40px;
    background: linear-gradient(180deg, rgba(255, 90, 31, 0), var(--color-cinnabar));
  }

  .vt-bridge__line::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cinnabar);
    box-shadow: 0 0 14px var(--color-cinnabar);
    transform: translateX(-50%);
  }

  .vt-main {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }

  /* ---------- Visual ---------- */
  .vt-visual {
    position: relative;
    margin: 0;
    display: flex;
    justify-content: center;
  }

  .vt-visual__halo {
    position: absolute;
    inset: 12% 6% 8%;
    border-radius: 50%;
    border: 1px solid rgba(244, 236, 220, 0.08);
    background: radial-gradient(circle at 50% 40%, rgba(255, 133, 84, 0.18), transparent 65%);
  }

  .vt-visual__img {
    position: relative;
    width: 100%;
    max-width: 420px;
    height: auto;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
  }

  .vt-visual__live {
    position: absolute;
    top: 14%;
    right: 6%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--color-bone);
    background: rgba(14, 11, 8, 0.7);
    border: 1px solid rgba(255, 90, 31, 0.5);
    backdrop-filter: blur(8px);
  }

  .vt-visual__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cinnabar);
    box-shadow: 0 0 10px var(--color-cinnabar);
    animation: vt-pulse 1.6s ease-in-out infinite;
  }

  @keyframes vt-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  /* ---------- Copy ---------- */
  .vt-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
    margin-bottom: 28px;
  }

  .vt-title {
    color: var(--color-bone);
    margin-bottom: 24px;
  }

  .vt-subtitle {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0 0 40px;
    max-width: 560px;
  }

  .vt-abilities {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
  }

  .vt-ability {
    padding: 24px 22px;
    background: linear-gradient(180deg, rgba(244, 236, 220, 0.04) 0%, rgba(244, 236, 220, 0.015) 100%);
    border: 1px solid rgba(244, 236, 220, 0.1);
    border-radius: 16px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .vt-ability:hover {
    border-color: rgba(255, 90, 31, 0.4);
    transform: translateY(-3px);
  }

  .vt-ability__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.26em;
    color: var(--color-cinnabar);
    margin-bottom: 10px;
  }

  .vt-ability--perform .vt-ability__tag,
  .vt-ability--social .vt-ability__tag {
    color: var(--color-gold);
  }

  .vt-ability__title {
    font-family: var(--font-headline);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-bone);
    margin: 0 0 10px;
  }

  .vt-ability__body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0;
  }

  .vt-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .vt-cta__icon {
    width: 18px;
    height: 18px;
    flex: none;
  }

  /* ---------- RWD ---------- */
  @media (max-width: 1023px) {
    .vt-main {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .vt-visual__img {
      max-width: 320px;
    }
  }

  @media (max-width: 767px) {
    .vt {
      padding: 24px 20px 96px;
    }

    .vt-bridge {
      margin-bottom: 56px;
    }

    .vt-bridge__line {
      height: 64px;
      margin-top: 32px;
    }

    .vt-abilities {
      grid-template-columns: 1fr;
    }

    .vt-cta__btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-visual__dot {
      animation: none;
    }

    .vt-ability {
      transition: none;
    }
  }
</style>
