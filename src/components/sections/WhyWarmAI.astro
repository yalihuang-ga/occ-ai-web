---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cases = [
  {
    label: '01',
    title: t('warm.why.case1.title'),
    body: t('warm.why.case1.body'),
  },
  {
    label: '02',
    title: t('warm.why.case2.title'),
    body: t('warm.why.case2.body'),
  },
  {
    label: '03',
    title: t('warm.why.case3.title'),
    body: t('warm.why.case3.body'),
  },
];
---

<section class="why-warm" aria-labelledby="why-warm-title">
  <div class="why-bg" aria-hidden="true">
    <div class="why-bg__glow why-bg__glow--a"></div>
    <div class="why-bg__glow why-bg__glow--b"></div>
  </div>

  <div class="why-container">
    <header class="why-head">
      <span class="why-eyebrow">{t('warm.why.eyebrow')}</span>
      <h2 id="why-warm-title" class="h1-display why-title" set:html={t('warm.why.title')} />
      <p class="why-subtitle">{t('warm.why.subtitle')}</p>
    </header>

    <ul class="why-cases" role="list">
      {cases.map((c) => (
        <li class="why-case">
          <span class="why-case__num">{c.label}</span>
          <h3 class="why-case__title">{c.title}</h3>
          <p class="why-case__body">{c.body}</p>
        </li>
      ))}
    </ul>

    <div class="why-closing">
      <p class="why-closing__lead">{t('warm.why.closing.lead')}</p>
      <p class="why-closing__body">{t('warm.why.closing.body')}</p>
      <p class="why-closing__tag" set:html={t('warm.why.closing.tag')} />
    </div>
  </div>
</section>

<style>
  .why-warm {
    position: relative;
    padding: 140px 24px 120px;
    background: #0a0908;
    color: var(--color-bone);
    overflow: hidden;
    isolation: isolate;
  }

  .why-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .why-bg__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .why-bg__glow--a {
    width: 520px;
    height: 520px;
    top: -120px;
    left: -180px;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.18), transparent 65%);
  }

  .why-bg__glow--b {
    width: 480px;
    height: 480px;
    bottom: -100px;
    right: -160px;
    background: radial-gradient(circle, rgba(217, 184, 114, 0.1), transparent 65%);
  }

  .why-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .why-head {
    text-align: center;
    margin-bottom: 80px;
  }

  .why-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
    margin-bottom: 28px;
  }

  .why-title {
    color: var(--color-bone);
    margin-bottom: 24px;
  }

  .why-subtitle {
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.65;
    color: var(--color-bone-2);
    max-width: 560px;
    margin: 0 auto;
  }

  .why-cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0 0 88px;
  }

  .why-case {
    position: relative;
    padding: 36px 32px 32px;
    background: rgba(244, 236, 220, 0.025);
    border: 1px solid rgba(244, 236, 220, 0.08);
    border-radius: 16px;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }

  .why-case:hover {
    border-color: rgba(255, 90, 31, 0.35);
    background: rgba(255, 90, 31, 0.04);
    transform: translateY(-3px);
  }

  .why-case__num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--color-cinnabar);
    margin-bottom: 18px;
  }

  .why-case__title {
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-bone);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .why-case__body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0;
  }

  .why-closing {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 0;
    border-top: 1px solid rgba(244, 236, 220, 0.08);
  }

  .why-closing__lead {
    font-family: var(--font-headline);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-bone);
    margin: 0 0 16px;
  }

  .why-closing__body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0 0 36px;
  }

  .why-closing__tag {
    display: inline-block;
    font-family: var(--font-headline);
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-bone);
    padding: 22px 32px;
    border: 1px solid rgba(255, 90, 31, 0.35);
    border-radius: 999px;
    background: rgba(255, 90, 31, 0.04);
  }

  @media (max-width: 1023px) {
    .why-cases {
      grid-template-columns: 1fr 1fr;
    }
    .why-case:nth-child(3) {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .why-warm {
      padding: 96px 20px 88px;
    }
    .why-head {
      margin-bottom: 56px;
    }
    .why-cases {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 64px;
    }
    .why-case {
      padding: 28px 24px;
    }
    .why-case:nth-child(3) {
      grid-column: span 1;
    }
    .why-closing__tag {
      font-size: 18px;
      padding: 18px 22px;
      border-radius: 22px;
      display: block;
    }
  }
</style>
