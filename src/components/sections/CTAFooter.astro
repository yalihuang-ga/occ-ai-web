---
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import MuztrixGlyph from '../MuztrixGlyph.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const productLinks = [
  { href: getLocalizedPath(lang, 'virtual-human'), label: t('footer.col1.i1') },
  { href: getLocalizedPath(lang, 'comic'), label: t('footer.col1.i2') },
  { href: getLocalizedPath(lang, 'game'), label: t('footer.col1.i3') },
] as const;

const relatedLinks = [
  {
    href: 'https://www.gamania.com/',
    label: t('footer.related.gamania'),
  },
  { href: 'https://mojoin.com/', label: t('footer.related.mojoin') },
  {
    href: 'https://mangacanvas.gamaniaocc.org/',
    label: t('footer.related.mangacanvas'),
  },
] as const;

const linkStyle =
  'color: var(--color-bone-2); text-decoration: none; font-size: 13px;';

const ctaContacts = [
  {
    role: t('cta.contact1.role'),
    name: t('cta.contact1.name'),
    email: 'mazzchou@gamania.com',
  },
  {
    role: t('cta.contact2.role'),
    name: t('cta.contact2.name'),
    email: 'yalihuang@gamania.com',
  },
] as const;
const ctaMailtoHref = `mailto:${ctaContacts.map((c) => c.email).join(',')}`;
---

<section
  id="contact"
  class="relative mx-section overflow-hidden"
  style="padding: 180px 48px 60px;"
>
  <div
    class="absolute inset-0"
    style="z-index: 0; background: radial-gradient(ellipse at 50% 0%, rgba(255,90,31,0.18), transparent 60%);"
  >
  </div>

  <div
    style="max-width: 1440px; margin: 0 auto; position: relative; z-index: 2;"
  >
    <!-- CTA -->
    <div
      class="mx-cta-row grid items-start"
      style="grid-template-columns: 1fr 1fr; gap: 96px; padding-bottom: 100px; border-bottom: 1px solid var(--bone-line);"
    >
        <div>
        <h2 class="h1-display" style="margin: 0; color: var(--color-bone);" set:html={t('cta.title')} />
        <p
          class="body-lg-v2 mx-cta-body"
          style="margin-top: 36px;"
        >
          {t('cta.body')}
        </p>
      </div>
      <div>
        <a
          href={ctaMailtoHref}
          class="shimmer-btn shimmer-btn-primary"
          style="padding: 24px 36px; font-size: 18px;"
        >
          {t('cta.button')}
        </a>
        <div class="mx-cta-contacts">
          {
            ctaContacts.map((c) => (
              <div class="mx-cta-contact-row">
                <span class="mx-cta-contact-meta">
                  {c.role} · {c.name}
                </span>
                <span class="mx-cta-contact-email-row">
                  <a
                    href={`mailto:${c.email}`}
                    class="mx-cta-contact-mail"
                  >
                    {c.email}
                  </a>
                  <button
                    type="button"
                    class="mx-cta-copy-single"
                    data-copy-email={c.email}
                    aria-label="Copy email"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer style="padding-top: 48px;">
      <div
        class="mx-footer-cols grid mb-16"
        style="grid-template-columns: 2fr 1fr 1fr; gap: 48px;"
      >
        <div>
          <a class="wordmark wordmark--lg" href="#hero">
            <MuztrixGlyph size={44} />
            <span>Muztrix</span>
          </a>
        </div>
        <div>
          <h5
            style="font-family: var(--font-headline); font-size: 11px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-cinnabar); margin: 0 0 18px;"
          >
            {t('footer.col1.h')}
          </h5>
          <ul
            style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;"
          >
            {
              productLinks.map(({ href, label }) => (
                <li>
                  <a href={href} style={linkStyle}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h5
            style="font-family: var(--font-headline); font-size: 11px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-cinnabar); margin: 0 0 18px;"
          >
            {t('footer.related.h')}
          </h5>
          <ul
            style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;"
          >
            {
              relatedLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    style={linkStyle}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Big outlined wordmark (hidden until we have final hero copy here) -->
      <div
        class="mx-footer-muztrix-outlined"
        style="font-family: var(--font-headline); font-weight: 700; font-size: clamp(80px, 18vw, 280px); line-height: 0.85; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px var(--bone-line); margin: 40px 0 32px; display: flex; align-items: baseline; gap: 12px;"
      >
        Muztrix
        <span
          style="font-size: 0.15em; -webkit-text-stroke: none; color: var(--color-cinnabar); letter-spacing: 0.2em;"
          >·</span
        >
      </div>

      <div class="mx-footer-bottom">
        <span class="mx-footer-copy">{t('footer.copyright')}</span>
        <span class="mx-footer-address">{t('footer.address')}</span>
      </div>
    </footer>
  </div>
</section>

<script>
  (function () {
    const btns = document.querySelectorAll('[data-copy-email]');
    btns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-copy-email') || '';
        try {
          await navigator.clipboard.writeText(email);
          const tip = document.createElement('span');
          tip.className = 'copied-tip';
          tip.textContent = 'Copied!';
          btn.appendChild(tip);
          window.setTimeout(() => {
            tip.remove();
          }, 1800);
        } catch {
          window.prompt('Copy:', email);
        }
      });
    });
  })();
</script>

<style>
  .mx-footer-muztrix-outlined {
    display: none !important;
  }

  /* Same column width as .h-display title; pretty wraps for CJK / long lines */
  .mx-cta-body {
    text-wrap: pretty;
  }

  .mx-cta-contacts {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mx-cta-contact-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mx-cta-contact-meta {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-bone-2);
  }
  .mx-cta-contact-email-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mx-cta-contact-mail {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--color-bone-3);
    text-decoration: none;
    transition: color 0.25s;
  }
  .mx-cta-contact-mail:hover {
    color: var(--color-cinnabar);
  }
  .mx-cta-copy-single {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-bone-3);
    background: transparent;
    border: none;
    padding: 4px;
    cursor: pointer;
    transition: color 0.25s;
    position: relative;
  }
  .mx-cta-copy-single:hover {
    color: var(--color-cinnabar);
  }
  .mx-cta-copy-single .copied-tip {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--color-cinnabar);
    white-space: nowrap;
    animation: fadeUp 0.3s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateX(-50%) translateY(4px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .mx-footer-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--bone-line);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px 28px;
    color: var(--color-bone-3);
  }
  .mx-footer-copy {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    justify-self: start;
    text-align: left;
  }
  .mx-footer-address {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.55;
    color: var(--color-bone-3);
    justify-self: end;
    text-align: right;
  }

  @container page (max-width: 900px) {
    .mx-cta-row {
      grid-template-columns: 1fr !important;
      gap: 48px !important;
      padding-bottom: 64px !important;
    }
    .mx-footer-cols {
      grid-template-columns: 1fr 1fr !important;
      gap: 32px !important;
    }
  }
  @container page (max-width: 600px) {
    .mx-footer-cols {
      grid-template-columns: 1fr !important;
    }
    .mx-footer-bottom {
      grid-template-columns: 1fr;
    }
    .mx-footer-address {
      justify-self: end;
    }
  }
</style>
