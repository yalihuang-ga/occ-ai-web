---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Detection overlay boxes — positions are % of the illustration frame. */
const boxes = [
  { key: 'industries.resto.box1', x: 16, y: 28, w: 18, h: 16, variant: 'occupied' },
  { key: 'industries.resto.box2', x: 36, y: 36, w: 20, h: 18, variant: 'free' },
  { key: 'industries.resto.box3', x: 58.5, y: 31, w: 9, h: 21, variant: 'serving' },
  { key: 'industries.resto.box4', x: 41, y: 56, w: 15, h: 17, variant: 'occupied' },
  { key: 'industries.resto.box5', x: 46, y: 9, w: 26, h: 15, variant: 'free' },
] as const;

const restoMetrics = [
  'industries.resto.m1',
  'industries.resto.m2',
  'industries.resto.m3',
  'industries.resto.m4',
  'industries.resto.m5',
  'industries.resto.m6',
] as const;

const medPills = [
  'industries.med.p1',
  'industries.med.p2',
  'industries.med.p3',
  'industries.med.p4',
] as const;
---

<section id="industries" class="relative mx-section mx-industries">
  <div style="max-width: 1440px; margin: 0 auto;">
    <!-- Section header -->
    <div class="mx-section-head" style="margin-bottom: 72px;">
      <div class="eyebrow eyebrow--muted" style="margin-bottom: 20px;">
        {t('industries.section')}
      </div>
      <h2
        class="h1-display"
        style="color: var(--color-bone); margin-bottom: 28px;"
        set:html={t('industries.title')}
      />
      <p class="body-lg-v2">{t('industries.subtitle')}</p>
    </div>

    <!-- Featured: F&B AI Vision -->
    <article class="ind-featured">
      <!-- Visual: AI illustration + detection overlay -->
      <div class="ind-visual">
        <img
          src="/images/resto-iso.webp"
          alt={t('industries.resto.title')}
          loading="lazy"
          decoding="async"
          class="ind-visual-img"
        />

        {/* Detection boxes */}
        {
          boxes.map((b, i) => (
            <div
              class:list={['ind-box', `ind-box--${b.variant}`]}
              style={`left:${b.x}%; top:${b.y}%; width:${b.w}%; height:${b.h}%; animation-delay:${i * 0.6}s;`}
              aria-hidden="true"
            >
              <span class="ind-box-label">{t(b.key)}</span>
            </div>
          ))
        }

        {/* Corner HUD chrome */}
        <div class="ind-hud ind-hud-tl" aria-hidden="true">● REC-FREE · EDGE INFERENCE</div>
        <div class="ind-hud ind-hud-br" aria-hidden="true">{t('industries.resto.note')}</div>
      </div>

      <!-- Content -->
      <div class="ind-featured-body">
        <div class="ind-meta">
          <span class="eyebrow eyebrow--muted">{t('industries.resto.tag')}</span>
          <span class="ind-status">
            <span class="ind-status-dot"></span>
            {t('industries.resto.status')}
          </span>
        </div>
        <h3 class="ind-title">{t('industries.resto.title')}</h3>
        <p class="body-md-v2" style="margin: 0 0 28px;">{t('industries.resto.desc')}</p>

        <div class="ind-tags">
          {
            restoMetrics.map((m) => (
              <span class="solution-tag">
                <span class="solution-tag-dot" />
                {t(m)}
              </span>
            ))
          }
        </div>

        <div class="ind-privacy">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          {t('industries.resto.privacy')}
        </div>

        <a href="#contact" class="ind-cta">
          {t('industries.resto.cta')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </article>

    <!-- Secondary: Medical + Agetech -->
    <div class="ind-grid">
      <article class="ind-card">
        <div class="ind-meta">
          <span class="eyebrow eyebrow--muted">{t('industries.med.tag')}</span>
          <span class="ind-status">
            <span class="ind-status-dot"></span>
            {t('industries.med.status')}
          </span>
        </div>
        <h3 class="ind-title ind-title--sm">{t('industries.med.title')}</h3>
        <p class="body-md-v2" style="margin: 0 0 24px;">{t('industries.med.desc')}</p>
        <div class="ind-tags" style="margin-bottom: 28px;">
          {
            medPills.map((p) => (
              <span class="solution-tag">
                <span class="solution-tag-dot" />
                {t(p)}
              </span>
            ))
          }
        </div>
        <a href="#contact" class="ind-cta">
          {t('industries.med.cta')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </article>

      <article class="ind-card">
        <div class="ind-meta">
          <span class="eyebrow eyebrow--muted">{t('industries.age.tag')}</span>
          <span class="ind-status">
            <span class="ind-status-dot"></span>
            {t('industries.age.status')}
          </span>
        </div>
        <h3 class="ind-title ind-title--sm">{t('industries.age.title')}</h3>
        <p class="body-md-v2" style="margin: 0 0 28px;">{t('industries.age.desc')}</p>
        <a href="/agetech" class="ind-cta">
          {t('industries.age.cta')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .mx-industries {
    padding: 160px 48px 140px;
    background: linear-gradient(180deg, var(--color-ink) 0%, #0c0a07 100%);
  }

  /* ---- Featured F&B card ---- */
  .ind-featured {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1px;
    background: var(--bone-line);
    border: 1px solid var(--bone-line);
    margin-bottom: 1px;
  }

  .ind-visual {
    position: relative;
    background: #0a0908;
    overflow: hidden;
    min-height: 420px;
  }

  .ind-visual-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Detection boxes */
  .ind-box {
    position: absolute;
    border: 1px solid rgba(255, 90, 31, 0.75);
    box-shadow:
      0 0 12px rgba(255, 90, 31, 0.18),
      inset 0 0 24px rgba(255, 90, 31, 0.06);
    animation: indBoxPulse 3.6s ease-in-out infinite;
  }

  .ind-box--free {
    border-color: rgba(200, 160, 60, 0.75);
    box-shadow:
      0 0 12px rgba(200, 160, 60, 0.16),
      inset 0 0 24px rgba(200, 160, 60, 0.05);
  }

  .ind-box--serving {
    border-style: dashed;
  }

  /* Corner ticks */
  .ind-box::before,
  .ind-box::after {
    content: '';
    position: absolute;
    width: 7px;
    height: 7px;
  }
  .ind-box::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
    color: rgba(255, 90, 31, 0.95);
  }
  .ind-box::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid currentColor;
    border-right: 2px solid currentColor;
    color: rgba(255, 90, 31, 0.95);
  }
  .ind-box--free::before,
  .ind-box--free::after {
    color: rgba(200, 160, 60, 0.95);
  }

  .ind-box-label {
    position: absolute;
    top: -22px;
    left: -1px;
    padding: 3px 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: #ffd9c4;
    background: rgba(14, 11, 8, 0.82);
    border: 1px solid rgba(255, 90, 31, 0.45);
    backdrop-filter: blur(4px);
  }
  .ind-box--free .ind-box-label {
    color: #f0e3bd;
    border-color: rgba(200, 160, 60, 0.45);
  }

  @keyframes indBoxPulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* HUD corners */
  .ind-hud {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 10px;
    background: rgba(14, 11, 8, 0.78);
    border: 1px solid var(--bone-line);
    color: rgba(244, 236, 220, 0.65);
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .ind-hud-tl {
    top: 14px;
    left: 14px;
    color: rgba(255, 138, 90, 0.85);
  }
  .ind-hud-br {
    bottom: 14px;
    right: 14px;
  }

  /* Featured content column */
  .ind-featured-body {
    background: var(--color-ink);
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ind-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .ind-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    padding: 5px 12px;
    border: 1px solid rgba(200, 160, 60, 0.35);
    border-radius: 999px;
  }

  .ind-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-gold);
    box-shadow: 0 0 8px rgba(200, 160, 60, 0.8);
    animation: indBoxPulse 2.4s ease-in-out infinite;
  }

  .ind-title {
    font-family: var(--font-headline);
    font-size: 42px;
    font-weight: 400;
    color: var(--color-bone);
    margin: 0 0 20px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .ind-title--sm {
    font-size: 32px;
  }

  .ind-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .ind-privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(244, 236, 220, 0.55);
    margin-bottom: 32px;
  }
  .ind-privacy svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .ind-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding: 0.65rem 1.3rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    text-decoration: none;
    border: 1px solid rgba(200, 160, 60, 0.3);
    border-radius: 4px;
    transition: gap 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .ind-cta:hover {
    gap: 0.7rem;
    background: rgba(200, 160, 60, 0.1);
    border-color: rgba(200, 160, 60, 0.6);
    color: var(--color-bone);
  }

  /* ---- Secondary 2-up grid ---- */
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--bone-line);
    border: 1px solid var(--bone-line);
    border-top: none;
  }

  .ind-card {
    background: var(--color-ink);
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ---- Responsive ---- */
  @container page (max-width: 900px) {
    .mx-industries {
      padding: 96px 20px 80px !important;
    }
    .ind-featured {
      grid-template-columns: 1fr !important;
    }
    .ind-visual {
      min-height: 0 !important;
      aspect-ratio: 3 / 2;
    }
    .ind-featured-body,
    .ind-card {
      padding: 36px 24px !important;
    }
    .ind-grid {
      grid-template-columns: 1fr !important;
    }
    .ind-title {
      font-size: 30px !important;
    }
    .ind-title--sm {
      font-size: 26px !important;
    }
    .ind-box-label {
      font-size: 8px !important;
      top: -19px !important;
    }
    .ind-hud {
      font-size: 8px !important;
    }
  }
</style>
