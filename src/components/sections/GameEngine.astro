      '既存のエンジンは「一人がエディタの前に座る」前提で設計されています。状態はエディタの中に隠れ、乱数は制御できず、インスタンスは一度に一つ。エージェントが必要とするのは正反対です。成熟したオープンソースエンジンを基盤にコアを改造し、プロジェクト形式の完全互換を保ちながら、第一版では四つの能力に集中します。',
    cores: [
      {
        title: '決定論的シミュレーション',
        desc: '固定タイムステップ、制御可能な乱数シード、記録・再生できる入力。同じシードなら一万回走らせても同じ結果——だから欠陥を確実に再現できます。',
      },
      {
        title: '状態スナップショットと内省',
        desc: '任意のティックで完全なゲーム状態をシリアライズして差分比較。エージェントが読むのは意味のある状態であり、スクリーンショットからの推測ではありません。',
      },
      {
        title: 'バッチ・ヘッドレス実行',
        desc: 'レンダリングを剥がしアセットを共有、一つのプロセスで数百インスタンスを同時実行。テストをスケールさせます。',
      },
      {
        title: 'トランザクション編集',
        desc: 'エージェントの操作はすべてアトミックなトランザクション。一括承認・一括取り消し・差分出力。エージェントが何を触ったか、常に見えます。',
      },
    ],
    coreLocalTitle: 'ローカル優先のモデルルーティング',
    coreLocalDesc:
      'スタジオの最も機微な資産は未発表のプロジェクトです。モデルルーティング層はオンプレミスのオープンモデル推論に対応し、コスト・レイテンシ・機微度で自動選択。未公開プロジェクトは一切外に出さずに完結でき、クラウドAPIは前提ではなく選択肢です。',
    principleSection: '§ 04 — Principles',
    principleTitle: '三つの設計原則',
    principles: [
      {
        title: '基準は「リリースできる」',
        desc: '「エラーがない」は完成ではありません。テストに通らない、性能予算を超える、コンプライアンス検査に落ちる——その場合エンジンは通しません。',
      },
      {
        title: 'ループはエンジン内で閉じる',
        desc: '生成・テスト・修正・再テスト・リリースを同一ランタイムで。ファイルの持ち運びも、ツールの切り替えもなし。',
      },
      {
        title: '人は承認の場面にだけ現れる',
        desc: '自動生成された変更と文書はすべてドラフトで、完全な証拠チェーン付き。承認するのは人、責任を持つのも人です。',
      },
    ],
    joinSection: '§ 05 — Work in Progress',
    joinTitle: 'プラットフォームはまだ建設中——<br />だからこそ、今が参加の好機',
    joinBody:
      '私たちが公開しているのは完成品ではなく、いま形になりつつある方向性です。エンジンコアの改造と自律テストエージェントを開発中で、修正・リリースエージェントが続きます。この方向にピンと来たなら——一緒に作りたい方も、これで自分のゲームを作りたい方も——ぜひお話ししましょう。',
    joinCards: [
      {
        title: 'ゲーム開発者・スタジオ',
        desc: '早期検証パートナーとして、実プロジェクトで自律テストと修正能力を一緒に検証し、機能の優先順位に直接影響を。',
      },
      {
        title: 'エンジニア・研究者',
        desc: 'エージェントによるプレイテスト、決定論的シミュレーション、エンジンツールチェーンに興味があり、最新研究を本当に出荷できる製品にしたい方。',
      },
      {
        title: 'ゲーム開発パートナーシップ',
        desc: 'AIで自社ゲームの制作とリリースを加速したい、あるいは共同開発・コンテンツ協業の可能性を探りたい方。',
      },
    ],
    joinCta: 'メールで相談する',
  },
} as const;

const c = copy[lang];

/* Terminal mocks — intentionally English in every locale (tool output). */
const consoles = [
  {
    cmd: 'engine playtest --headless --instances 200',
    lines: [
      { kind: 'run', text: 'exploring 200 instances · path coverage 94%' },
      { kind: 'err', text: '[L2] platform gap unreachable — replay #0417' },
      { kind: 'err', text: '[L2] dash × wall-corner collision lock — replay #0988' },
      { kind: 'err', text: '[L3] boss clear-rate 8% — balance breach' },
      { kind: 'ok', text: '3 defects reported · each with replayable input sequence' },
    ],
  },
  {
    cmd: 'engine repair --from-replays --regress',
    lines: [
      { kind: 'ok', text: 'fix: raise L2 platform +12px → regression passed' },
      { kind: 'ok', text: 'fix: rebuild wall-corner collision shape → regression passed' },
      { kind: 'ok', text: 'balance: boss HP 300 → 220 · clear-rate 8% → 45%' },
      { kind: 'run', text: 'perf: L3 particle count over budget → auto-tiered' },
      { kind: 'warn', text: 'narrative: "last night" vs same-day timeline → flagged for review' },
    ],
  },
  {
    cmd: 'engine publish --channels steam,cloud --dry-run',
    lines: [
      { kind: 'ok', text: 'rating self-assessment → draft ready' },
      { kind: 'ok', text: 'AI content disclosure (pre-generated / live-generated) → draft ready' },
      { kind: 'ok', text: 'content provenance credentials → signed' },
      { kind: 'run', text: 'build: desktop package + cloud container → test channel' },
      { kind: 'wait', text: 'awaiting human approval …' },
    ],
  },
] as const;

const glyphFor = (kind: string) =>
  kind === 'err' ? '✗' : kind === 'warn' ? '⚠' : kind === 'wait' ? '…' : kind === 'run' ? '▸' : '✓';
---

<section id="game" class="ge mx-section">
  <!-- ============ Hero ============ -->
  <div class="ge-hero">
    <div class="ge-hero-bg" aria-hidden="true"></div>
    <div class="ge-inner ge-hero-inner">
      <div class="ge-hero-eyebrow-row">
        <span class="eyebrow">{c.heroEyebrow}</span>
        <span class="ge-status"><span class="ge-status-dot" aria-hidden="true"></span>{c.heroStatus}</span>
      </div>
      <h1 class="h-display ge-hero-title" set:html={c.heroTitle} />
      <p class="body-lg-v2 ge-hero-desc">{c.heroDesc}</p>
      <div class="ge-hero-ctas">
        <a href="#contact" class="shimmer-btn shimmer-btn-primary ge-cta-main">{c.heroCtaPrimary}</a>
        <a href="#pipeline" class="shimmer-btn shimmer-btn-glass ge-cta-sub">{c.heroCtaSecondary}</a>
      </div>
      <div class="ge-hero-badges">
        {
          c.heroBadges.map((b, i) => (
            <div class="ge-hero-badge">
              <span class="ge-hero-badge-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ge-hero-badge-title">{b.title}</h3>
              <p class="ge-hero-badge-desc">{b.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 01 Pain ============ -->
  <div class="ge-block">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.painSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.painTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.painIntro}</p>
      <div class="ge-pain-grid">
        {
          c.pains.map((p, i) => (
            <div class="ge-pain-card">
              <span class="ge-pain-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ge-card-title">{p.title}</h3>
              <p class="ge-card-desc">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 02 Pipeline ============ -->
  <div class="ge-block ge-block--tint" id="pipeline">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.pipelineSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.pipelineTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.pipelineIntro}</p>

      <!-- Flow rail -->
      <div class="ge-flow" role="list">
        {
          c.flowNodes.map((n, i) => (
            <>
              <div
                class:list={['ge-flow-node', i === c.flowNodes.length - 1 && 'ge-flow-node--human']}
                role="listitem"
              >
                <span class="ge-flow-node-label">{n}</span>
                {i === c.flowNodes.length - 1 && <span class="ge-flow-node-note">{c.flowHumanNote}</span>}
              </div>
              {i < c.flowNodes.length - 1 && <span class="ge-flow-arrow" aria-hidden="true">→</span>}
            </>
          ))
        }
      </div>

      <!-- Agent detail rows -->
      <div class="ge-agents">
        {
          c.agents.map((a, i) => (
            <div class="ge-agent">
              <div class="ge-agent-copy">
                <div class="ge-agent-head">
                  <span class="ge-agent-num">{a.num}</span>
                  <span class="ge-agent-label">{a.label}</span>
                </div>
                <h3 class="h3-display ge-agent-title">{a.title}</h3>
                <p class="ge-card-desc">{a.desc}</p>
                <div class="ge-agent-tags">
                  {a.tags.map((tag) => (
                    <span class="solution-tag">
                      <span class="solution-tag-dot" />
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="ge-console" aria-hidden="true">
                <div class="ge-console-bar">
                  <span class="ge-console-dot" />
                  <span class="ge-console-dot" />
                  <span class="ge-console-dot" />
                </div>
                <div class="ge-console-body">
                  <div class="ge-console-line ge-console-line--cmd">
                    <span class="ge-console-prompt">$</span> {consoles[i].cmd}
                  </div>
                  {consoles[i].lines.map((l) => (
                    <div class:list={['ge-console-line', `ge-console-line--${l.kind}`]}>
                      <span class="ge-console-glyph">{glyphFor(l.kind)}</span> {l.text}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 03 Engine core ============ -->
  <div class="ge-block">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.coreSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.coreTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.coreIntro}</p>
      <div class="ge-core-grid">
        {
          c.cores.map((f) => (
            <div class="ge-core-card">
              <h3 class="ge-card-title">{f.title}</h3>
              <p class="ge-card-desc">{f.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="ge-core-local">
        <div class="ge-core-local-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <div>
          <h3 class="ge-card-title">{c.coreLocalTitle}</h3>
          <p class="ge-card-desc">{c.coreLocalDesc}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ § 04 Principles ============ -->
  <div class="ge-block ge-block--tint">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.principleSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title">{c.principleTitle}</h2>
      <div class="ge-principles">
        {
          c.principles.map((p, i) => (
            <div class="ge-principle">
              <span class="ge-principle-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="ge-card-title">{p.title}</h3>
                <p class="ge-card-desc">{p.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 05 Join ============ -->
  <div class="ge-block ge-join">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.joinSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.joinTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.joinBody}</p>
      <div class="ge-join-grid">
        {
          c.joinCards.map((card) => (
            <div class="ge-join-card">
              <h3 class="ge-card-title">{card.title}</h3>
              <p class="ge-card-desc">{card.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="ge-join-cta">
        <a href="#contact" class="shimmer-btn shimmer-btn-primary ge-cta-main">{c.joinCta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .ge {
    background: var(--color-ink);
    color: var(--color-bone);
  }
  .ge-inner {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* ---------- Hero ---------- */
  .ge-hero {
    position: relative;
    padding: 180px 48px 110px;
    overflow: hidden;
  }
  .ge-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 55% at 70% 0%, rgba(255, 90, 31, 0.14), transparent 65%),
      radial-gradient(ellipse 60% 45% at 15% 20%, rgba(201, 162, 94, 0.08), transparent 60%),
      linear-gradient(
        to right,
        transparent 0,
        transparent calc(100% / 6 - 1px),
        rgba(237, 230, 216, 0.04) calc(100% / 6 - 1px),
        rgba(237, 230, 216, 0.04) calc(100% / 6)
      );
    background-size: 100% 100%, 100% 100%, calc(100% / 6) 100%;
    pointer-events: none;
  }
  .ge-hero-eyebrow-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 36px;
  }
  .ge-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-gold);
    border: 1px solid rgba(201, 162, 94, 0.35);
    border-radius: 999px;
    padding: 7px 16px;
    background: rgba(201, 162, 94, 0.06);
  }
  .ge-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: ge-pulse 2.2s ease-in-out infinite;
  }
  @keyframes ge-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(201, 162, 94, 0.5); }
    50% { opacity: 0.55; box-shadow: 0 0 0 5px rgba(201, 162, 94, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ge-status-dot { animation: none; }
  }
  .ge-hero-title {
    margin: 0 0 32px;
    max-width: 20ch;
    text-wrap: balance;
  }
  .ge-hero-desc {
    max-width: 46em;
    margin: 0 0 44px;
    text-wrap: pretty;
  }
  .ge-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 88px;
  }
  .ge-cta-main {
    padding: 22px 40px;
    font-size: 17px;
  }
  .ge-cta-sub {
    padding: 22px 36px;
    font-size: 16px;
  }
  .ge-hero-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--bone-line);
    border: 1px solid var(--bone-line);
  }
  .ge-hero-badge {
    background: var(--color-ink);
    padding: 30px 28px 32px;
  }
  .ge-hero-badge-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-cinnabar);
  }
  .ge-hero-badge-title {
    font-family: var(--font-headline);
    font-size: 19px;
    font-weight: 600;
    color: var(--color-bone);
    margin: 12px 0 10px;
  }
  .ge-hero-badge-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-bone-2);
    margin: 0;
  }

  /* ---------- Shared block scaffolding ---------- */
  .ge-block {
    padding: 130px 48px;
  }
  .ge-block--tint {
    background: linear-gradient(180deg, rgba(255, 90, 31, 0.035), transparent 30%),
      #0a0805;
  }
  .ge-section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 44px;
  }
  .ge-block-title {
    margin: 0 0 28px;
    max-width: 24ch;
    text-wrap: balance;
  }
  .ge-block-intro {
    max-width: 44em;
    margin: 0 0 64px;
    text-wrap: pretty;
  }
  .ge-card-title {
    font-family: var(--font-headline);
    font-size: 19px;
    font-weight: 600;
    color: var(--color-bone);
    margin: 0 0 12px;
    line-height: 1.4;
  }
  .ge-card-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0;
    text-wrap: pretty;
  }

  /* ---------- § 01 Pain ---------- */
  .ge-pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .ge-pain-card {
    border: 1px solid var(--bone-line);
    padding: 34px 32px 36px;
    background: rgba(237, 230, 216, 0.015);
    transition: border-color 0.3s;
  }
  .ge-pain-card:hover {
    border-color: rgba(255, 90, 31, 0.4);
  }
  .ge-pain-index {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-cinnabar);
    margin-bottom: 16px;
  }

  /* ---------- § 02 Flow rail ---------- */
  .ge-flow {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 96px;
  }
  .ge-flow-node {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    border: 1px solid var(--bone-line);
    padding: 16px 22px;
    background: rgba(237, 230, 216, 0.02);
  }
  .ge-flow-node-label {
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
