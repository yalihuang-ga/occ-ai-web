    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(201, 162, 94, 0.75);
    white-space: nowrap;
  }
  .ge-flow-arrow {
    align-self: center;
    color: var(--color-cinnabar);
    font-size: 15px;
  }

  /* ---------- § 02 Agent rows ---------- */
  .ge-agents {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }
  .ge-agent {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 72px;
    align-items: center;
  }
  .ge-agent:nth-child(even) .ge-agent-copy {
    order: 2;
  }
  .ge-agent-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
  }
  .ge-agent-num {
    font-family: var(--font-headline);
    font-weight: 200;
    font-size: 44px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 90, 31, 0.65);
  }
  .ge-agent-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--color-bone-3);
  }
  .ge-agent-title {
    margin: 0 0 18px;
    color: var(--color-bone);
  }
  .ge-agent-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  /* Console mock */
  .ge-console {
    border: 1px solid var(--bone-line);
    border-radius: 10px;
    background: #0c0a07;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }
  .ge-console-bar {
    display: flex;
    gap: 7px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--bone-line);
    background: rgba(237, 230, 216, 0.025);
  }
  .ge-console-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(237, 230, 216, 0.14);
  }
  .ge-console-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ge-console-line {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--color-bone-2);
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .ge-console-glyph,
  .ge-console-prompt {
    flex: none;
    width: 14px;
  }
  .ge-console-line--cmd {
    color: var(--color-bone);
    margin-bottom: 6px;
  }
