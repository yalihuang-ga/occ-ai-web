      '既存のエンジンは「一人がエディタの前に座る」前提で設計されています。状態はエディタの中に隠れ、乱数は制御できず、インスタンスは一度に一つ。エージェントが必要とするのは正反対です。成熟したオープンソースエンジンを基盤にコアを改造し、プロジェクト形式の完全互換を保ちながら、四つの能力に集中します。',
    cores: [
      {
        title: '決定論的シミュレーション',
        desc: '固定タイムステップ、制御可能な乱数シード、記録・再生できる入力。同じシードなら一万回走らせても同じ結果——だから欠陥を確実に再現できます。',
      },
      {
        title: '状態スナップショットと内省',
        desc: '任意のティックで完全なゲーム状態をシリアライズして差分比較。AIエージェントが読むのは意味のある状態であり、スクリーンショットから推測する必要はありません。',
      },
      {
        title: 'バッチ・ヘッドレス実行',
        desc: 'レンダリングを剥がしアセットを共有、一つのプロセスで数百インスタンスを同時実行。テストをスケールさせます。',
      },
      {
        title: 'トランザクション編集',
        desc: 'AIエージェントの操作はすべてアトミックなトランザクション。一括承認・一括取り消し・差分出力。AIエージェントが何を触ったか、常に見えます。',
      },
    ],
    coreLocalTitle: 'ローカル優先のモデルルーティング',
    coreLocalDesc:
      'スタジオの最も機微な資産は未発表のプロジェクトです。モデルルーティング層はオンプレミスのオープンモデル推論に対応し、コスト・レイテンシ・機微度で自動選択。未公開プロジェクトは一切外に出さずに完結でき、クラウドAPIはプロジェクトの必要に応じて柔軟に選択できます。',
    principleSection: '§ 04 — Principles',
    principleTitle: '三つの設計原則',
    principles: [
      {
        title: '基準を「リリースできる」へ引き上げる',
        desc: '「エラーがない」は完成ではありません。テストに通らない、性能予算を超える、コンプライアンス検査に落ちる——その場合エンジンは通しません。',
      },
      {
        title: 'ループはエンジン内で閉じる',
        desc: '生成・テスト・修正・再テスト・リリースを同一ランタイムで。ファイルの持ち運びも、ツールの切り替えもなし。',
      },
      {
        title: '人は承認の場面にだけ関わる',
        desc: '自動生成された変更と文書はすべてドラフトで、完全な証拠チェーン付き。人が承認する——だから最終責任も人にあります。',
      },
    ],
    joinSection: '§ 05 — Join Us',
    joinTitle: '物語は始まったばかり——<br />参加するなら、今',
    joinBody:
      '長年のゲームパブリッシング経験を土台に、ゲームエンジンの次の一歩は「ツール」から「AIエージェント」へ、と私たちは考えています。この方向にピンと来たなら——一緒に作りたい方も、これで自分のゲームを作りたい方も——ぜひ意見を交わしましょう。',
    joinCards: [
      {
        title: 'ゲーム開発者・スタジオ',
        desc: '実プロジェクトで自律テストと修正能力を一緒に検証し、機能の優先順位に直接影響を。',
      },
      {
        title: 'エンジニア・研究者',
        desc: 'AIエージェントによるプレイテスト、決定論的シミュレーション、エンジンツールチェーンに興味があり、最新研究を本当にリリースして市場に届く製品にしたい方。',
      },
      {
        title: 'ゲーム開発パートナーシップ',
        desc: 'AIで自社ゲームの制作とリリースを加速したい、あるいは共同開発・コンテンツ協業の可能性を探りたい方。',
      },
    ],
  },
} as const;

const c = copy[lang];

/* Terminal mocks — intentionally English in every locale (tool output). */
const consoles = [
  {
    cmd: 'engine playtest --headless --instances 200',
    lines: [
      { kind: 'run', text: 'exploring 200 instances · path coverage 94%' },
      { kind: 'err', text: '[L2] platform gap unreachable — replay #0417' },
      { kind: 'err', text: '[L2] dash × wall-corner collision lock — replay #0988' },
      { kind: 'err', text: '[L3] boss clear-rate 8% — balance breach' },
      { kind: 'ok', text: '3 defects reported · each with replayable input sequence' },
    ],
  },
  {
    cmd: 'engine repair --from-replays --regress',
    lines: [
      { kind: 'ok', text: 'fix: raise L2 platform +12px → regression passed' },
      { kind: 'ok', text: 'fix: rebuild wall-corner collision shape → regression passed' },
      { kind: 'ok', text: 'balance: boss HP 300 → 220 · clear-rate 8% → 45%' },
      { kind: 'run', text: 'perf: L3 particle count over budget → auto-tiered' },
      { kind: 'warn', text: 'narrative: "last night" vs same-day timeline → flagged for review' },
    ],
  },
  {
    cmd: 'engine publish --channels steam,cloud --dry-run',
    lines: [
      { kind: 'ok', text: 'rating self-assessment → draft ready' },
      { kind: 'ok', text: 'AI content disclosure (pre-generated / live-generated) → draft ready' },
      { kind: 'ok', text: 'content provenance credentials → signed' },
      { kind: 'run', text: 'build: desktop package + cloud container → test channel' },
      { kind: 'wait', text: 'awaiting human approval …' },
    ],
  },
] as const;

const glyphFor = (kind: string) =>
  kind === 'err' ? '✗' : kind === 'warn' ? '⚠' : kind === 'wait' ? '…' : kind === 'run' ? '▸' : '✓';

/* Hero badge icons — stroke style matches ComicFlow's cf-badge-icon set. */
const badgeIcons = [
  /* playtest — play */
  '<circle cx="12" cy="12" r="9" /><polygon points="10 8.5 16 12 10 15.5 10 8.5" />',
  /* repair — wrench */
  '<path d="M14.7 6.3a4.5 4.5 0 0 0-6 6L3 18l3 3 5.7-5.7a4.5 4.5 0 0 0 6-6l-3 3-3-3 3-3z" />',
  /* publish — upload box */
  '<path d="M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" /><polyline points="8 7 12 3 16 7" /><line x1="12" y1="3" x2="12" y2="15" />',
] as const;
---

<section id="game" class="ge mx-section">
  <!-- ============ Hero ============ -->
  <div class="ge-hero">
    <div class="ge-hero-bg" aria-hidden="true"></div>
    <div class="ge-inner ge-hero-inner">
      <div class="ge-hero-eyebrow-row">
        <span class="ge-eyebrow">{c.heroEyebrow}</span>
        <span class="ge-status"><span class="ge-status-dot" aria-hidden="true"></span>{c.heroStatus}</span>
      </div>
      <h1 class="h-display ge-hero-title" set:html={c.heroTitle} />
      <p class="body-lg-v2 ge-hero-desc">{c.heroDesc}</p>
      <div class="ge-hero-ctas">
        <a href="#contact" class="shimmer-btn shimmer-btn-primary ge-cta-main">{c.heroCtaPrimary}</a>
        <a href="#pipeline" class="shimmer-btn shimmer-btn-glass ge-cta-sub">{c.heroCtaSecondary}</a>
      </div>
      <div class="ge-hero-badges" data-badge-rotate>
        {
          c.heroBadges.map((b, i) => (
            <div class="ge-hero-badge" data-badge-idx={i}>
              <div class="ge-badge-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={badgeIcons[i]}
                />
              </div>
              <h3 class="ge-hero-badge-title">{b.title}</h3>
              <p class="ge-hero-badge-desc">{b.desc}</p>
            </div>
          ))
        }
      </div>
      <!-- Scroll indicator (matches comic page) -->
      <div class="ge-hero-scroll" aria-hidden="true">
        <span class="ge-hero-scroll-label">SCROLL</span>
        <span class="ge-hero-scroll-line"><span class="ge-hero-scroll-dot"></span></span>
      </div>
    </div>
  </div>

  <!-- ============ § 01 Pain ============ -->
  <div class="ge-block">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.painSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.painTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.painIntro}</p>
      <div class="ge-pain-grid">
        {
          c.pains.map((p, i) => (
            <div class="ge-pain-card" data-reveal>
              <span class="ge-pain-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ge-card-title">{p.title}</h3>
              <p class="ge-card-desc">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 02 Pipeline ============ -->
  <div class="ge-block ge-block--tint" id="pipeline">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.pipelineSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.pipelineTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.pipelineIntro}</p>

      <!-- Flow rail -->
      <div class="ge-flow" role="list" data-flow-sweep>
        {
          c.flowNodes.map((n, i) => (
            <>
              <div
                class:list={['ge-flow-node', i === c.flowNodes.length - 1 && 'ge-flow-node--human']}
                role="listitem"
                data-flow-node={i}
              >
                <span class="ge-flow-node-label">{n}</span>
                {i === c.flowNodes.length - 1 && <span class="ge-flow-node-note">{c.flowHumanNote}</span>}
              </div>
              {i < c.flowNodes.length - 1 && <span class="ge-flow-arrow" aria-hidden="true">→</span>}
            </>
          ))
        }
      </div>

      <!-- Agent detail rows -->
      <div class="ge-agents">
        {
          c.agents.map((a, i) => (
            <div class="ge-agent">
              <div class="ge-agent-copy" data-reveal>
                <div class="ge-agent-head">
                  <span class="ge-agent-num">{a.num}</span>
                  <span class="ge-agent-label">{a.label}</span>
                </div>
                <h3 class="h3-display ge-agent-title">{a.title}</h3>
                <p class="ge-card-desc">{a.desc}</p>
                <div class="ge-agent-tags">
                  {a.tags.map((tag) => (
                    <span class="solution-tag">
                      <span class="solution-tag-dot" />
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <div class="ge-console" aria-hidden="true" data-console>
                <div class="ge-console-bar">
                  <span class="ge-console-dot" />
                  <span class="ge-console-dot" />
                  <span class="ge-console-dot" />
                </div>
                <div class="ge-console-body">
                  <div class="ge-console-line ge-console-line--cmd">
                    <span class="ge-console-prompt">$</span> {consoles[i].cmd}
                  </div>
                  {consoles[i].lines.map((l) => (
                    <div class:list={['ge-console-line', `ge-console-line--${l.kind}`]}>
                      <span class="ge-console-glyph">{glyphFor(l.kind)}</span> {l.text}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 03 Engine core ============ -->
  <div class="ge-block">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.coreSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.coreTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.coreIntro}</p>
      <div class="ge-core-grid">
        {
          c.cores.map((f) => (
            <div class="ge-core-card" data-reveal>
              <h3 class="ge-card-title">{f.title}</h3>
              <p class="ge-card-desc">{f.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="ge-core-local" data-reveal>
        <div class="ge-core-local-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        </div>
        <div>
          <h3 class="ge-card-title">{c.coreLocalTitle}</h3>
          <p class="ge-card-desc">{c.coreLocalDesc}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ § 04 Principles ============ -->
  <div class="ge-block ge-block--tint">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.principleSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title">{c.principleTitle}</h2>
      <div class="ge-principles">
        {
          c.principles.map((p, i) => (
            <div class="ge-principle" data-reveal>
              <span class="ge-principle-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="ge-card-title">{p.title}</h3>
                <p class="ge-card-desc">{p.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============ § 05 Join ============ -->
  <div class="ge-block ge-join">
    <div class="ge-inner">
      <div class="ge-section-head">
        <span class="num-tag">{c.joinSection}</span>
        <span class="hairline" style="flex:1;"></span>
      </div>
      <h2 class="h1-display ge-block-title" set:html={c.joinTitle} />
      <p class="body-lg-v2 ge-block-intro">{c.joinBody}</p>
      <div class="ge-join-grid">
        {
          c.joinCards.map((card) => (
            <div class="ge-join-card" data-reveal>
              <h3 class="ge-card-title">{card.title}</h3>
              <p class="ge-card-desc">{card.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Light, dependency-free motion. Everything is additive: without JS (or
   * with prefers-reduced-motion) the page renders fully static.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    const root = document.querySelector('.ge');
    if (root) {
      root.classList.add('ge-js');

      /* 1 — Hero badges: rotating highlight every 3s; pause while hovered. */
      const badgeWrap = root.querySelector('[data-badge-rotate]');
      if (badgeWrap) {
        const badges = [...badgeWrap.querySelectorAll('.ge-hero-badge')];
        let idx = 0;
        let paused = false;
        badgeWrap.addEventListener('mouseenter', () => (paused = true));
        badgeWrap.addEventListener('mouseleave', () => (paused = false));
        const tick = () => {
          if (!paused) {
            badges.forEach((b, i) => b.classList.toggle('ge-hero-badge--active', i === idx));
            idx = (idx + 1) % badges.length;
          }
        };
        tick();
        setInterval(tick, 3000);
      }

      /* 2 — Flow rail: a highlight sweeps through the pipeline nodes. */
      const flow = root.querySelector('[data-flow-sweep]');
      if (flow) {
        const nodes = [...flow.querySelectorAll('[data-flow-node]')];
        let fi = 0;
        setInterval(() => {
          nodes.forEach((n, i) => n.classList.toggle('ge-flow-node--run', i === fi));
          fi = (fi + 1) % (nodes.length + 1); // one empty beat before looping
        }, 1100);
      }

      /* 3 — Scroll reveal: fade-up cards as they enter the viewport. */
      const revealEls = [...root.querySelectorAll('[data-reveal]')];
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('ge-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      revealEls.forEach((el, i) => {
        // Stagger siblings inside the same grid.
        const siblings = el.parentElement ? [...el.parentElement.children] : [];
        const pos = Math.max(0, siblings.indexOf(el));
        (el as HTMLElement).style.transitionDelay = `${Math.min(pos, 3) * 90}ms`;
        io.observe(el);
      });

      /* 4 — Consoles: lines appear sequentially, like live output. */
      const cio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            const lines = [...e.target.querySelectorAll('.ge-console-line')];
            lines.forEach((line, i) => {
              window.setTimeout(() => line.classList.add('ge-in'), 150 + i * 260);
            });
          });
        },
        { threshold: 0.35 }
      );
      root.querySelectorAll('[data-console]').forEach((el) => cio.observe(el));
    }
  }
</script>

<style>
  .ge {
    background: var(--color-ink);
    color: var(--color-bone);
  }
  .ge-inner {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* ---------- Hero ---------- */
  .ge-hero {
    position: relative;
    padding: 180px 48px 110px;
    overflow: hidden;
  }
  .ge-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 55% at 70% 0%, rgba(255, 90, 31, 0.14), transparent 65%),
      radial-gradient(ellipse 60% 45% at 15% 20%, rgba(201, 162, 94, 0.08), transparent 60%);
    pointer-events: none;
  }
  .ge-hero-eyebrow-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 36px;
  }
  /* Mono eyebrow — matches comic page's cf-eyebrow */
  .ge-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
  }
  .ge-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-gold);
    border: 1px solid rgba(201, 162, 94, 0.35);
    border-radius: 999px;
    padding: 7px 16px;
    background: rgba(201, 162, 94, 0.06);
  }
  .ge-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: ge-pulse 2.2s ease-in-out infinite;
  }
  @keyframes ge-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(201, 162, 94, 0.5); }
    50% { opacity: 0.55; box-shadow: 0 0 0 5px rgba(201, 162, 94, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ge-status-dot,
    .ge-hero-scroll-dot {
      animation: none;
    }
  }
  .ge-hero-title {
    margin: 0 0 32px;
    max-width: 20ch;
    text-wrap: balance;
  }
  .ge-hero-desc {
    max-width: 46em;
    margin: 0 0 44px;
    text-wrap: pretty;
  }
  .ge-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-bottom: 88px;
  }
  .ge-cta-main {
    padding: 22px 40px;
    font-size: 17px;
  }
  .ge-cta-sub {
    padding: 22px 36px;
    font-size: 16px;
  }

  /* Hero badges — card style matches comic page's cf-hero-badge */
  .ge-hero-badges {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .ge-hero-badge {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px;
    border: 1px solid var(--bone-line);
    border-radius: 16px;
    background: rgba(244, 236, 220, 0.02);
    color: var(--color-bone);
    transition:
      border-color 0.5s ease,
      background 0.5s ease,
      transform 0.5s ease;
  }
  .ge-hero-badge--active {
    border-color: rgba(255, 90, 31, 0.5);
    background: rgba(255, 90, 31, 0.05);
    transform: translateY(-4px);
  }
  .ge-badge-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: rgba(255, 90, 31, 0.08);
    border: 1px solid rgba(255, 90, 31, 0.2);
    transition: box-shadow 0.5s ease;
  }
  .ge-badge-icon svg {
    color: var(--color-cinnabar);
  }
  .ge-hero-badge--active .ge-badge-icon {
    box-shadow: 0 0 22px rgba(255, 90, 31, 0.35);
  }
  .ge-hero-badge-title {
    font-family: var(--font-headline);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-bone);
    margin: 0;
  }
  .ge-hero-badge-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-bone-3);
    margin: 0;
  }

  /* Scroll indicator — matches comic page */
  .ge-hero-scroll {
    margin-top: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    pointer-events: none;
  }
  .ge-hero-scroll-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.4em;
    color: rgba(244, 236, 220, 0.55);
    text-transform: uppercase;
  }
  .ge-hero-scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, rgba(244, 236, 220, 0.25) 0%, transparent 100%);
    overflow: visible;
  }
  .ge-hero-scroll-dot {
    position: absolute;
