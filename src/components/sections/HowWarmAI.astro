---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const layers = [
  {
    key: 'eyes',
    label: t('warm.how.eyes.label'),
    title: t('warm.how.eyes.title'),
    body: t('warm.how.eyes.body'),
    example: t('warm.how.eyes.example'),
    icon: 'eye',
  },
  {
    key: 'brain',
    label: t('warm.how.brain.label'),
    title: t('warm.how.brain.title'),
    body: t('warm.how.brain.body'),
    example: t('warm.how.brain.example'),
    icon: 'brain',
  },
  {
    key: 'heart',
    label: t('warm.how.heart.label'),
    title: t('warm.how.heart.title'),
    body: t('warm.how.heart.body'),
    example: t('warm.how.heart.example'),
    icon: 'heart',
  },
];

const path = [
  {
    tag: t('warm.path.step1.tag'),
    title: t('warm.path.step1.title'),
    body: t('warm.path.step1.body'),
    state: 'done' as const,
  },
  {
    tag: t('warm.path.step2.tag'),
    title: t('warm.path.step2.title'),
    body: t('warm.path.step2.body'),
    state: 'active' as const,
  },
  {
    tag: t('warm.path.step3.tag'),
    title: t('warm.path.step3.title'),
    body: t('warm.path.step3.body'),
    state: 'next' as const,
  },
];
---

<section class="how-warm" aria-labelledby="how-warm-title">
  <div class="how-bg" aria-hidden="true">
    <div class="how-bg__grid"></div>
    <div class="how-bg__glow"></div>
  </div>

  <div class="how-container">
    <header class="how-head">
      <span class="how-eyebrow">{t('warm.how.eyebrow')}</span>
      <h2 id="how-warm-title" class="h1-display how-title" set:html={t('warm.how.title')} />
      <p class="how-subtitle">{t('warm.how.subtitle')}</p>
    </header>

    <ul class="how-layers" role="list">
      {layers.map((layer) => (
        <li class={`how-layer how-layer--${layer.key}`}>
          <div class="how-layer__icon" aria-hidden="true">
            {layer.icon === 'eye' && (
              <svg viewBox="0 0 64 64" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 32c5-9 16-16 28-16s23 7 28 16c-5 9-16 16-28 16S9 41 4 32z"/>
                <circle cx="32" cy="32" r="8"/>
                <circle cx="32" cy="32" r="2.4" fill="currentColor"/>
              </svg>
            )}
            {layer.icon === 'brain' && (
              <svg viewBox="0 0 64 64" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12a8 8 0 0 0-8 8c0 1.5.4 2.9 1.1 4A8 8 0 0 0 14 36a8 8 0 0 0 4 7v3a6 6 0 0 0 12 0V14a2 2 0 0 0-2-2"/>
                <path d="M42 12a8 8 0 0 1 8 8c0 1.5-.4 2.9-1.1 4A8 8 0 0 1 50 36a8 8 0 0 1-4 7v3a6 6 0 0 1-12 0V14a2 2 0 0 1 2-2"/>
                <path d="M24 24h6M40 24h-6M22 36h8M42 36h-8"/>
              </svg>
            )}
            {layer.icon === 'heart' && (
              <svg viewBox="0 0 64 64" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M32 52s-18-10.7-18-24a10 10 0 0 1 18-6 10 10 0 0 1 18 6c0 13.3-18 24-18 24z"/>
                <path d="M22 28h6l3-5 4 10 3-5h6"/>
              </svg>
            )}
          </div>

          <span class="how-layer__label">{layer.label}</span>
          <h3 class="how-layer__title">{layer.title}</h3>
          <p class="how-layer__body">{layer.body}</p>
          <p class="how-layer__example">{layer.example}</p>
        </li>
      ))}
    </ul>

    <div class="how-path">
      <header class="how-path__head">
        <span class="how-path__eyebrow">{t('warm.path.eyebrow')}</span>
        <h3 class="how-path__title" set:html={t('warm.path.title')} />
      </header>

      <ol class="how-path__steps" role="list">
        {path.map((step, idx) => (
          <li class={`how-path__step is-${step.state}`}>
            <div class="how-path__node" aria-hidden="true">
              <span class="how-path__dot"></span>
              <span class="how-path__index">{String(idx + 1).padStart(2, '0')}</span>
            </div>
            <span class="how-path__tag">{step.tag}</span>
            <h4 class="how-path__step-title">{step.title}</h4>
            <p class="how-path__step-body">{step.body}</p>
          </li>
        ))}
      </ol>

      <p class="how-path__note">{t('warm.path.note')}</p>
    </div>

    <div class="how-outro">
      <h3 class="how-outro__title">
        <span set:html={t('warm.outro.title')} />
        <br />
        <span set:html={t('warm.outro.title.line2')} />
      </h3>
      <p class="how-outro__body">{t('warm.outro.body')}</p>
    </div>
  </div>
</section>

<style>
  .how-warm {
    position: relative;
    padding: 140px 24px 140px;
    background: #0e0b08;
    color: var(--color-bone);
    overflow: hidden;
    isolation: isolate;
  }

  .how-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .how-bg__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(244, 236, 220, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(244, 236, 220, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 25%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 25%, #000 0%, transparent 70%);
  }

  .how-bg__glow {
    position: absolute;
    width: 720px;
    height: 720px;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 90, 31, 0.08), transparent 60%);
    filter: blur(80px);
  }

  .how-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .how-head {
    text-align: center;
    margin-bottom: 80px;
  }

  .how-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-cinnabar);
    margin-bottom: 28px;
  }

  .how-title {
    color: var(--color-bone);
    margin-bottom: 24px;
  }

  .how-subtitle {
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.65;
    color: var(--color-bone-2);
    max-width: 620px;
    margin: 0 auto;
  }

  /* ============================================================
     Eyes / Brain / Heart trio
     ============================================================ */
  .how-layers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0 0 120px;
  }

  .how-layer {
    position: relative;
    padding: 40px 32px 36px;
    background: linear-gradient(180deg, rgba(244, 236, 220, 0.04) 0%, rgba(244, 236, 220, 0.015) 100%);
    border: 1px solid rgba(244, 236, 220, 0.1);
    border-radius: 18px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .how-layer:hover {
    border-color: rgba(255, 90, 31, 0.4);
    transform: translateY(-4px);
  }

  .how-layer__icon {
    color: var(--color-cinnabar);
    margin-bottom: 24px;
  }

  .how-layer--brain .how-layer__icon { color: var(--color-gold); }
  .how-layer--heart .how-layer__icon { color: var(--color-cinnabar-soft); }

  .how-layer__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    color: var(--color-bone-3);
    margin-bottom: 12px;
  }

  .how-layer__title {
    font-family: var(--font-headline);
    font-size: 28px;
    font-weight: 500;
    color: var(--color-bone);
    margin: 0 0 18px;
    line-height: 1.25;
  }

  .how-layer__body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-bone-2);
    margin: 0 0 18px;
  }

  .how-layer__example {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-bone-3);
    font-style: italic;
    margin: 0;
    padding-top: 16px;
    border-top: 1px dashed rgba(244, 236, 220, 0.12);
  }

  /* ============================================================
     Mini roadmap
     ============================================================ */
  .how-path {
    padding: 64px 0;
    border-top: 1px solid rgba(244, 236, 220, 0.08);
    border-bottom: 1px solid rgba(244, 236, 220, 0.08);
    margin-bottom: 96px;
  }

  .how-path__head {
    text-align: center;
    margin-bottom: 56px;
  }

  .how-path__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--color-gold);
    margin-bottom: 16px;
  }

  .how-path__title {
    font-family: var(--font-headline);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-bone);
    margin: 0;
  }

  .how-path__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .how-path__steps::before {
    content: '';
    position: absolute;
    top: 17px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 90, 31, 0.6) 16%,
      rgba(255, 90, 31, 0.4) 50%,
      rgba(244, 236, 220, 0.18) 100%
    );
    z-index: 0;
  }

  .how-path__step {
    position: relative;
    padding-top: 50px;
    text-align: center;
  }

  .how-path__node {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .how-path__dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: rgba(244, 236, 220, 0.18);
    border: 2px solid #0e0b08;
    box-shadow: 0 0 0 2px rgba(244, 236, 220, 0.18);
  }

  .how-path__step.is-active .how-path__dot {
    background: var(--color-cinnabar);
    box-shadow: 0 0 0 2px rgba(255, 90, 31, 0.45), 0 0 16px rgba(255, 90, 31, 0.7);
    animation: hpDotPulse 2s ease-in-out infinite;
  }

  .how-path__step.is-done .how-path__dot {
    background: var(--color-gold);
    box-shadow: 0 0 0 2px rgba(217, 184, 114, 0.35);
  }

  .how-path__index {
    display: none;
  }

  .how-path__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--color-cinnabar);
    margin-bottom: 12px;
  }

  .how-path__step:not(.is-active) .how-path__tag {
    color: var(--color-bone-3);
  }

  .how-path__step.is-done .how-path__tag {
    color: var(--color-gold);
  }

  .how-path__step-title {
    font-family: var(--font-headline);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-bone);
    margin: 0 0 10px;
  }

  .how-path__step-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-bone-2);
    margin: 0;
    max-width: 240px;
    margin-inline: auto;
  }

  .how-path__note {
    margin: 56px auto 0;
    max-width: 640px;
    text-align: center;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-bone-2);
    font-style: italic;
  }

  @keyframes hpDotPulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(255, 90, 31, 0.45), 0 0 14px rgba(255, 90, 31, 0.55); }
    50% { box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.25), 0 0 22px rgba(255, 90, 31, 0.85); }
  }

  /* ============================================================
     Closing slogan
     ============================================================ */
  .how-outro {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .how-outro__title {
    font-family: var(--font-headline);
    font-size: clamp(32px, 4.4vw, 56px);
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-bone);
    margin: 0 0 28px;
    letter-spacing: -0.005em;
  }

  .how-outro__body {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.75;
    color: var(--color-bone-2);
    margin: 0 0 36px;
  }

  /* ============================================================
     RWD
     ============================================================ */
  @media (max-width: 1023px) {
    .how-layers {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 96px;
    }
  }

  @media (max-width: 767px) {
    .how-warm {
      padding: 96px 20px 96px;
    }
    .how-head {
      margin-bottom: 56px;
    }
    .how-layer {
      padding: 32px 24px 28px;
    }
    .how-layer__title {
      font-size: 24px;
    }
    .how-path {
      padding: 48px 0;
      margin-bottom: 72px;
    }
    .how-path__head {
      margin-bottom: 40px;
    }
    .how-path__steps {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .how-path__steps::before {
      top: 14px;
      bottom: 14px;
      left: 50%;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        rgba(255, 90, 31, 0.6) 0%,
        rgba(255, 90, 31, 0.3) 50%,
        rgba(244, 236, 220, 0.15) 100%
      );
    }
    .how-path__step {
      padding-top: 0;
      padding-left: 56px;
      text-align: left;
    }
    .how-path__node {
      top: 4px;
      left: 28px;
      transform: none;
    }
    .how-path__step-body {
      max-width: none;
      margin: 0;
    }
    .how-path__note {
      margin-top: 40px;
    }
    .how-outro__title {
      font-size: 30px;
    }
  }
</style>
