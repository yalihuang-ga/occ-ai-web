---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import VirtualHumanShowcase from '../islands/VirtualHumanShowcase.tsx';
import type { Scene } from '../islands/VirtualHumanShowcase.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const matrix = [
  { k: t('virtual.matrix.1k'), v: t('virtual.matrix.1v') },
  { k: t('virtual.matrix.2k'), v: t('virtual.matrix.2v') },
  { k: t('virtual.matrix.3k'), v: t('virtual.matrix.3v') },
  { k: t('virtual.matrix.4k'), v: t('virtual.matrix.4v') },
];

const scenes: Scene[] = [
  {
    key: 'boutique',
    label: t('vh.scene.boutique.label'),
    tag: t('vh.scene.boutique.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.boutique.g1') },
      { from: 'user', text: t('vh.scene.boutique.g2') },
      { from: 'vh', text: t('vh.scene.boutique.g3') },
    ],
    replies: [
      t('vh.scene.boutique.r1'),
      t('vh.scene.boutique.r2'),
      t('vh.scene.boutique.r3'),
    ],
    signals: [
      t('vh.scene.boutique.s1'),
      t('vh.scene.boutique.s2'),
      t('vh.scene.boutique.s3'),
      t('vh.scene.boutique.s4'),
      t('vh.scene.boutique.s5'),
    ],
  },
  {
    key: 'corporate',
    label: t('vh.scene.corporate.label'),
    tag: t('vh.scene.corporate.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.corporate.g1') },
      { from: 'user', text: t('vh.scene.corporate.g2') },
      { from: 'vh', text: t('vh.scene.corporate.g3') },
    ],
    replies: [
      t('vh.scene.corporate.r1'),
      t('vh.scene.corporate.r2'),
      t('vh.scene.corporate.r3'),
    ],
    signals: [
      t('vh.scene.corporate.s1'),
      t('vh.scene.corporate.s2'),
      t('vh.scene.corporate.s3'),
      t('vh.scene.corporate.s4'),
      t('vh.scene.corporate.s5'),
    ],
  },
  {
    key: 'ip',
    label: t('vh.scene.ip.label'),
    tag: t('vh.scene.ip.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.ip.g1') },
      { from: 'user', text: t('vh.scene.ip.g2') },
      { from: 'vh', text: t('vh.scene.ip.g3') },
    ],
    replies: [
      t('vh.scene.ip.r1'),
      t('vh.scene.ip.r2'),
      t('vh.scene.ip.r3'),
    ],
    signals: [
      t('vh.scene.ip.s1'),
      t('vh.scene.ip.s2'),
      t('vh.scene.ip.s3'),
      t('vh.scene.ip.s4'),
      t('vh.scene.ip.s5'),
    ],
  },
];
---

<section
  id="virtual"
  class="relative mx-section overflow-hidden"
  style="padding: 160px 48px; background: var(--color-ink);"
>
  <!-- Atmospheric blue glow -->
  <div
    class="absolute"
    style="left: -10%; top: 20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(27,40,64,0.5), transparent 60%); filter: blur(80px);"
  >
  </div>

  <div style="max-width: 1440px; margin: 0 auto; position: relative;">
    <!-- Section header — stacked single column -->
    <div class="mx-section-head" style="margin-bottom: 56px;">
      <div class="flex items-center gap-4 mb-7">
        <span class="num-tag">{t('virtual.section')}</span>
        <span style="flex: 1; height: 1px; background: var(--bone-line);"
        ></span>
      </div>
      <h2
        class="h1-display"
        style="color: var(--color-bone); margin-bottom: 28px;"
        set:html={t('virtual.title')}
      />
      <p class="body-lg-v2">
        {t('virtual.body1')}
      </p>
    </div>

    <!-- Three core pillars — replaces the previous body1/body2 list -->
    <div class="vh-pillars" style="margin-bottom: 64px;">
      {
        [
          { n: '01', k: t('vh.pillar1.k'), v: t('vh.pillar1.v') },
          { n: '02', k: t('vh.pillar2.k'), v: t('vh.pillar2.v') },
          { n: '03', k: t('vh.pillar3.k'), v: t('vh.pillar3.v') },
        ].map((p) => (
          <div class="vh-pillar">
            <div class="vh-pillar-num">{p.n}</div>
            <h3 class="vh-pillar-k">{p.k}</h3>
            <p class="vh-pillar-v">{p.v}</p>
          </div>
        ))
      }
    </div>

    <!-- Showcase island -->
    <VirtualHumanShowcase
      scenes={scenes}
      imgSrc="/images/miyaki-full.webp"
      ui={{
        modeLabel: t('vh.mode.label'),
        mode2d: t('vh.mode.2d'),
        mode3d: t('vh.mode.3d'),
        mode3dPending: t('vh.mode.3dPending'),
        sceneLabel: t('vh.scene.label'),
        perceptionLabel: t('virtual.demo.perception'),
        placeholder: t('virtual.demo.placeholder'),
        sendLabel: t('virtual.demo.send'),
        liveLabel: t('virtual.demo.live'),
        placeholder3dTitle: t('vh.placeholder.3d.title'),
        placeholder3dBody: t('vh.placeholder.3d.body'),
      }}
      client:visible
    />

    <!-- Capability matrix below -->
    <div
      class="grid mt-12"
      style="grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--bone-line);"
    >
      {
        matrix.map((c, i) => (
          <div
            style={`padding: 20px 22px; border-right: ${i < 3 ? '1px solid var(--bone-line)' : 'none'};`}
          >
            <div
              style="font-size: 10px; letter-spacing: 0.25em; color: var(--color-cinnabar); margin-bottom: 8px;"
            >
              {c.k}
            </div>
            <div class="body-sm-v2" style="color: var(--color-bone);">
              {c.v}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Three-pillar block — value-prop intro before the demo */
  .vh-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--bone-line);
    border-bottom: 1px solid var(--bone-line);
  }
  .vh-pillar {
    padding: 36px 32px;
    border-right: 1px solid var(--bone-line);
    position: relative;
  }
  .vh-pillar:last-child {
    border-right: none;
  }
  .vh-pillar-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    color: var(--color-cinnabar);
    margin-bottom: 14px;
  }
  .vh-pillar-k {
    font-family: var(--font-headline);
    font-size: 22px;
    font-weight: 500;
    color: var(--color-bone);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .vh-pillar-v {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-bone-2);
    margin: 0;
  }

  @container page (max-width: 900px) {
    .vh-pillars {
      grid-template-columns: 1fr;
    }
    .vh-pillar {
      border-right: none;
      border-bottom: 1px solid var(--bone-line);
      padding: 28px 4px;
    }
    .vh-pillar:last-child {
      border-bottom: none;
    }
  }
  @container page (max-width: 900px) {
    /* Capability matrix collapses to 2x2 on tablet */
    section#virtual .grid[style*="repeat(4, 1fr)"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    section#virtual .grid[style*="repeat(4, 1fr)"] > div:nth-child(2) {
      border-right: none !important;
    }
    section#virtual .grid[style*="repeat(4, 1fr)"] > div:nth-child(odd) {
      border-right: 1px solid var(--bone-line) !important;
    }
    section#virtual .grid[style*="repeat(4, 1fr)"] > div:nth-child(-n+2) {
      border-bottom: 1px solid var(--bone-line) !important;
    }
  }
  @container page (max-width: 600px) {
    section#virtual .grid[style*="repeat(4, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
    section#virtual .grid[style*="repeat(4, 1fr)"] > div {
      border-right: none !important;
      border-bottom: 1px solid var(--bone-line) !important;
    }
    section#virtual .grid[style*="repeat(4, 1fr)"] > div:last-child {
      border-bottom: none !important;
    }
  }
</style>
