---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import VirtualHumanShowcase from '../islands/VirtualHumanShowcase.tsx';
import type { Scene } from '../islands/VirtualHumanShowcase.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const matrixLines = [
  t('virtual.matrix.1v'),
  t('virtual.matrix.2v'),
  t('virtual.matrix.3v'),
  t('virtual.matrix.4v'),
];

const scenes: Scene[] = [
  {
    key: 'boutique',
    label: t('vh.scene.boutique.label'),
    tag: t('vh.scene.boutique.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.boutique.g1') },
      { from: 'user', text: t('vh.scene.boutique.g2') },
      { from: 'vh', text: t('vh.scene.boutique.g3') },
    ],
    replies: [
      t('vh.scene.boutique.r1'),
      t('vh.scene.boutique.r2'),
      t('vh.scene.boutique.r3'),
    ],
    signals: [
      t('vh.scene.boutique.s1'),
      t('vh.scene.boutique.s2'),
      t('vh.scene.boutique.s3'),
      t('vh.scene.boutique.s4'),
      t('vh.scene.boutique.s5'),
    ],
  },
  {
    key: 'corporate',
    label: t('vh.scene.corporate.label'),
    tag: t('vh.scene.corporate.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.corporate.g1') },
      { from: 'user', text: t('vh.scene.corporate.g2') },
      { from: 'vh', text: t('vh.scene.corporate.g3') },
    ],
    replies: [
      t('vh.scene.corporate.r1'),
      t('vh.scene.corporate.r2'),
      t('vh.scene.corporate.r3'),
    ],
    signals: [
      t('vh.scene.corporate.s1'),
      t('vh.scene.corporate.s2'),
      t('vh.scene.corporate.s3'),
      t('vh.scene.corporate.s4'),
      t('vh.scene.corporate.s5'),
    ],
  },
  {
    key: 'ip',
    label: t('vh.scene.ip.label'),
    tag: t('vh.scene.ip.tag'),
    greeting: [
      { from: 'vh', text: t('vh.scene.ip.g1') },
      { from: 'user', text: t('vh.scene.ip.g2') },
      { from: 'vh', text: t('vh.scene.ip.g3') },
    ],
    replies: [
      t('vh.scene.ip.r1'),
      t('vh.scene.ip.r2'),
      t('vh.scene.ip.r3'),
    ],
    signals: [
      t('vh.scene.ip.s1'),
      t('vh.scene.ip.s2'),
      t('vh.scene.ip.s3'),
      t('vh.scene.ip.s4'),
      t('vh.scene.ip.s5'),
    ],
  },
];
---

<section
  id="virtual"
  class="relative mx-section overflow-hidden"
  style="padding: 160px 48px; background: var(--color-ink);"
>
  <!-- Atmospheric blue glow -->
  <div
    class="absolute"
    style="left: -10%; top: 20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(27,40,64,0.5), transparent 60%); filter: blur(80px);"
  >
  </div>

  <div style="max-width: 1440px; margin: 0 auto; position: relative;">
    <!-- Section header — stacked single column -->
    <div class="mx-section-head" style="margin-bottom: 48px;">
      <div class="flex items-center gap-4 mb-7">
        <span class="num-tag">{t('virtual.section')}</span>
        <span style="flex: 1; height: 1px; background: var(--bone-line);"
        ></span>
      </div>
      <h2
        class="h1-display"
        style="color: var(--color-bone); margin-bottom: 28px;"
        set:html={t('virtual.title')}
      />
      <p class="body-lg-v2">
        {t('virtual.body1')}
      </p>
    </div>

    <!-- Showcase island -->
    <VirtualHumanShowcase
      scenes={scenes}
      imgSrc="/images/miyaki-full.webp"
      imgSrcSmile="/images/miyakien-smile.png"
      imgSrcThinking="/images/miyakien-thinking.png"
      ui={{
        modeLabel: t('vh.mode.label'),
        mode2d: t('vh.mode.2d'),
        mode3d: t('vh.mode.3d'),
        mode3dPending: t('vh.mode.3dPending'),
        sceneLabel: t('vh.scene.label'),
        perceptionLabel: t('virtual.demo.perception'),
        placeholder: t('virtual.demo.placeholder'),
        sendLabel: t('virtual.demo.send'),
        liveLabel: t('virtual.demo.live'),
        placeholder3dTitle: t('vh.placeholder.3d.title'),
        placeholder3dBody: t('vh.placeholder.3d.body'),
        analysisTexts: [t('vh.analysis.t1'), t('vh.analysis.t2'), t('vh.analysis.t3'), t('vh.analysis.t4'), t('vh.analysis.t5')],
      }}
      client:visible
    />

    <!-- Capability matrix — same cinnabar pill tags as Solutions -->
    <div
      class="virtual-cap-tags mt-12 flex flex-wrap"
      style="gap: 10px;"
    >
      {
        matrixLines.map((line) => (
          <span class="solution-tag">
            <span class="solution-tag-dot" />
            <span class="solution-tag-body">{line}</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  @container page (max-width: 600px) {
    .virtual-cap-tags {
      gap: 8px !important;
    }
    .virtual-cap-tags :global(.solution-tag) {
      padding: 7px 12px;
      font-size: 11px;
    }
  }
</style>
