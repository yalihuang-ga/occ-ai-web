---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import VirtualHumanShowcase from '../islands/VirtualHumanShowcase.tsx';
import type { Scene } from '../islands/VirtualHumanShowcase.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const scenes: Scene[] = [
  {
    key: 'boutique',
    title: t('vh.scene.boutique.title'),
    description: t('vh.scene.boutique.desc'),
    videoMp4: '/video/vh/aivtuber_miyaki_happy_clean.mp4',
    perceptionLabels: [
      t('vh.label.boutique.1'),
      t('vh.label.boutique.2'),
      t('vh.label.boutique.3'),
    ],
    greeting: [
      { from: 'vh', text: t('vh.scene.boutique.g1'), audio: '/audio/vh/boutique-1.mp3' },
      { from: 'user', text: t('vh.scene.boutique.g2') },
      { from: 'vh', text: t('vh.scene.boutique.g3'), audio: '/audio/vh/boutique-2.mp3' },
    ],
  },
  {
    key: 'corporate',
    title: t('vh.scene.corporate.title'),
    description: t('vh.scene.corporate.desc'),
    videoMp4: '/video/vh/aivtuber_receptionist_happy_clean.mp4',
    perceptionLabels: [
      t('vh.label.corporate.1'),
      t('vh.label.corporate.2'),
      t('vh.label.corporate.3'),
    ],
    greeting: [
      { from: 'vh', text: t('vh.scene.corporate.g1'), audio: '/audio/vh/corporate-1.mp3' },
      { from: 'user', text: t('vh.scene.corporate.g2') },
      { from: 'vh', text: t('vh.scene.corporate.g3'), audio: '/audio/vh/corporate-2.mp3' },
    ],
  },
  {
    key: 'ip',
    title: t('vh.scene.ip.title'),
    description: t('vh.scene.ip.desc'),
    videoMp4: '/video/vh/aivtuber_miyaki_confused_clean.mp4',
    perceptionLabels: [
      t('vh.label.ip.1'),
      t('vh.label.ip.2'),
      t('vh.label.ip.3'),
    ],
    greeting: [
      { from: 'vh', text: t('vh.scene.ip.g1'), audio: '/audio/vh/ip-1.mp3' },
      { from: 'user', text: t('vh.scene.ip.g2') },
      { from: 'vh', text: t('vh.scene.ip.g3'), audio: '/audio/vh/ip-2.mp3' },
    ],
  },
];
---

<section
  id="virtual"
  class="relative mx-section overflow-hidden"
  style="padding: 120px 24px; background: var(--color-ink);"
>
  <div
    class="absolute"
    style="left: -10%; top: 20%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(27,40,64,0.5), transparent 60%); filter: blur(80px);"
  >
  </div>

  <div style="max-width: 1100px; margin: 0 auto; position: relative;">
    <!-- Section header -->
    <div class="mx-section-head" style="margin-bottom: 80px; text-align: center;">
      <h2
        class="h1-display"
        style="color: var(--color-bone); margin-bottom: 20px;"
        set:html={t('vh.scenes.title')}
      />
      <p class="body-lg-v2" style="max-width: 640px; margin: 0 auto;">
        {t('vh.scenes.subtitle')}
      </p>
    </div>

    <!-- Showcase island — alternating left/right scenes -->
    <VirtualHumanShowcase
      scenes={scenes}
      client:visible
    />
  </div>
</section>
