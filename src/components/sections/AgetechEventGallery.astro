---
const photos = [
  { alt: '2026 臺北生成藝術節參與者與工作人員大合照' },
  { alt: '2026 臺北生成藝術節頒發合作單位感謝狀，舞台展示遊戲橘子原創中心標誌' },
  { alt: '遊戲橘子原創中心團隊於生成藝術節現場諮詢區合照' },
  { alt: '臺北市政府頒發的 2026 臺北生成藝術節感謝狀' },
];
---

<div class="ag-event-gallery" data-event-gallery role="region" aria-roledescription="輪播" aria-label="2026 臺北生成藝術節活動花絮">
  <div class="gallery-heading">
    <p>2026 生成藝術節・活動花絮</p>
  </div>
  <div class="gallery-window">
  <ul class="gallery-track" id="ag-event-photos" aria-label="活動照片">
    {photos.map((photo, index) => (
      <li>
        <figure>
          <img src={`/images/agetech/art-festival-2026-${index + 1}.webp`} alt={photo.alt} width="260" height="170" loading="lazy" decoding="async" />
        </figure>
      </li>
    ))}
  </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-event-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('.gallery-track');
    if (!track) return;
    // A second copy keeps the strip filled while the first photo moves out.
    // Move that photo to the end after each transition, then reset the offset.
    Array.from(track.children).forEach((photo) => {
      const copy = photo.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.dataset.duplicate = '';
      track.append(copy);
    });
    let moving = false;
    track.addEventListener('transitionend', (event) => {
      if (event.target !== track || event.propertyName !== 'transform' || !moving) return;
      if (track.firstElementChild) track.append(track.firstElementChild);
      track.classList.remove('is-moving');
      track.style.transform = 'translateX(0)';
      moving = false;
    });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let timer: ReturnType<typeof setInterval> | undefined;

    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (!inView || document.hidden || reducedMotion.matches || gallery.matches(':hover, :focus-within')) return;
      timer = setInterval(() => {
        if (moving) return;
        const step = (track.querySelector('li')?.getBoundingClientRect().width ?? 260) + 16;
        moving = true;
        // Commit the reset position before starting the next leftward step.
        track.getBoundingClientRect();
        track.classList.add('is-moving');
        track.style.transform = `translateX(-${step}px)`;
      }, 5000);
    };

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      start();
    }).observe(gallery);
    gallery.addEventListener('mouseenter', stop);
    gallery.addEventListener('mouseleave', start);
    gallery.addEventListener('focusin', stop);
    gallery.addEventListener('focusout', () => requestAnimationFrame(start));
    gallery.addEventListener('touchstart', stop, { passive: true });
    gallery.addEventListener('touchend', start, { passive: true });
    gallery.addEventListener('touchcancel', start, { passive: true });
    document.addEventListener('visibilitychange', start);
    reducedMotion.addEventListener('change', start);
    window.addEventListener('pagehide', stop);
    window.addEventListener('pageshow', start);
  });
</script>

<style>
  .ag-event-gallery { margin-top: 28px; }
  .gallery-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .gallery-heading p { margin: 0; color: var(--ag-ink-2); font-size: 16px; }
  .gallery-window { overflow: hidden; }
  .gallery-track { display: flex; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .gallery-track.is-moving { transition: transform 650ms ease-in-out; }
  .gallery-track li { flex: 0 0 260px; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: 170px; object-fit: contain; border-radius: 8px; background: var(--ag-bg-tint); }
  @media (max-width: 640px) {
    .gallery-track li { flex-basis: min(240px, 80vw); }
    img { height: 160px; }
  }
  @media print {
    .gallery-window { overflow: visible; }
    .gallery-track { flex-wrap: wrap; transform: none !important; transition: none !important; }
    .gallery-track [data-duplicate] { display: none; }
    .gallery-track li { break-inside: avoid; }
  }
</style>
