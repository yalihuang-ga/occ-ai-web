---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { COMPUTEX_META } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="cx-banner" role="note" aria-label="Computex 2026">
  <a class="cx-banner__inner" href={COMPUTEX_META.url} target="_blank" rel="noopener noreferrer">
    <span class="cx-banner__dot" aria-hidden="true"></span>
    <span class="cx-banner__eyebrow">{t('warm.banner.eyebrow')}</span>
    <span class="cx-banner__sep" aria-hidden="true">/</span>
    <span class="cx-banner__text">{t('warm.banner.text')}</span>
    <span class="cx-banner__cta">
      {t('warm.banner.cta')}
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
</aside>

<style>
  .cx-banner {
    position: relative;
    z-index: 60;
    width: 100%;
    background:
      linear-gradient(90deg, rgba(255, 90, 31, 0.08) 0%, rgba(255, 90, 31, 0.02) 50%, rgba(255, 90, 31, 0.08) 100%),
      #0e0b08;
    border-bottom: 1px solid rgba(255, 90, 31, 0.22);
    color: rgba(244, 236, 220, 0.92);
  }

  .cx-banner__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 9px 24px;
    text-decoration: none;
    color: inherit;
    font-size: 12.5px;
    line-height: 1.4;
    transition: background 0.2s ease;
  }

  .cx-banner__inner:hover {
    background: rgba(255, 90, 31, 0.06);
  }

  .cx-banner__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 120, 60, 1);
    box-shadow: 0 0 8px rgba(255, 90, 31, 0.85);
    animation: cxDotPulse 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }

  .cx-banner__eyebrow {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: rgba(255, 168, 120, 0.95);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .cx-banner__sep {
    color: rgba(244, 236, 220, 0.25);
    flex-shrink: 0;
  }

  .cx-banner__text {
    color: rgba(244, 236, 220, 0.82);
    font-weight: 400;
  }

  .cx-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: rgba(255, 168, 120, 0.95);
    font-weight: 600;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .cx-banner__cta svg {
    transition: transform 0.2s ease;
  }

  .cx-banner__inner:hover .cx-banner__cta svg {
    transform: translateX(2px);
  }

  @keyframes cxDotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  @media (max-width: 767px) {
    .cx-banner__inner {
      padding: 8px 16px;
      gap: 8px;
      font-size: 11.5px;
    }
    .cx-banner__sep {
      display: none;
    }
    .cx-banner__text {
      display: none;
    }
  }
</style>
