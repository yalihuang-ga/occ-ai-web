---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import HeroVisual from '../islands/HeroVisual.tsx';
import HeroBackground from '../islands/HeroBackground.tsx';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="hero"
  class="relative flex min-h-svh flex-col items-start overflow-hidden md:min-h-screen md:flex-row md:items-center"
>
  {/* Layer 0: atmospheric background — grid + particles (idle hydration) */}
  <HeroBackground client:idle />

  {/* Layer 1: Character — three-stage transformation (line art → color → neon) */}
  <HeroVisual
    lineSrc="/images/miyaki-draft.webp"
    lineSrcMobile="/images/miyaki-draft-mobile.webp"
    colorSrc="/images/miyaki-full.webp"
    colorSrcMobile="/images/miyaki-full-mobile.webp"
    alt="Muztrix AI Virtual Human"
    client:visible
  />

  {/* Layer 2: Text overlay — z-20, edge slightly overlaps character */}
  <div
    class="relative z-20 mx-auto w-full max-w-[1440px] px-container-padding pb-16 pt-20 md:pb-20 md:pt-32"
  >
    <div class="max-w-[900px]">
      <p
        class="text-label-sm uppercase tracking-[0.25em] text-primary mb-6 font-headline"
      >
        {t('hero.eyebrow')}
      </p>
      <h1
        class="font-headline text-white leading-[1.05] mb-10 tracking-tight mx-hero-title"
        style="font-weight: 600; text-shadow: 0 4px 40px rgba(0,0,0,0.6);"
      >
        {t('hero.title.line1')}<span class="text-primary">{t('hero.title.line2')}</span>
      </h1>
      <p
        class="text-body-lg text-on-surface-variant max-w-xl mb-12 leading-relaxed"
        style="text-shadow: 0 2px 20px rgba(0,0,0,0.6);"
      >
        {t('hero.desc')}
      </p>

      <div class="flex flex-wrap gap-5">
        <a href="#contact" class="shimmer-btn shimmer-btn-primary">
          <svg
            class="relative z-10"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" />
          </svg>
          <span class="relative z-10">{t('hero.cta.secondary')}</span>
        </a>
      </div>
    </div>
  </div>

  {/* Bottom fade — character/background blends into next section */}
  <div
    class="absolute bottom-0 left-0 right-0 h-[280px] pointer-events-none z-30"
    style="background: linear-gradient(to bottom, transparent 0%, rgba(10,10,12,0.6) 60%, #0a0a0c 100%);"
  >
  </div>

  {/* Scroll cue — bottom-center, animated travelling dot */}
  <div class="hero-scroll" aria-hidden="true">
    <span class="hero-scroll-label">SCROLL</span>
    <span class="hero-scroll-line">
      <span class="hero-scroll-dot"></span>
    </span>
  </div>
</section>

<style>
  /* Largest headline site-wide: above .h-display (max 144px) and .h1-display (max 88px) */
  .mx-hero-title {
    font-size: clamp(64px, 10.8vw, 172px);
    text-wrap: balance;
  }

  /* Scroll cue — in document flow on mobile (avoids huge gap under CTA); fixed to hero bottom on md+ */
  .hero-scroll {
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .hero-scroll {
      position: relative;
      align-self: center;
      margin-top: 2.5rem;
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .hero-scroll {
      position: absolute;
      bottom: 36px;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .hero-scroll-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.4em;
    color: rgba(244, 236, 220, 0.55);
    text-transform: uppercase;
  }

  .hero-scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: linear-gradient(
      to bottom,
      rgba(244, 236, 220, 0.25) 0%,
      transparent 100%
    );
    overflow: visible;
  }

  .hero-scroll-dot {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 1px;
    height: 14px;
    transform: translateX(-50%);
    background: #ff5a1f;
    box-shadow:
      0 0 6px rgba(255, 90, 31, 0.7),
      0 0 14px rgba(255, 90, 31, 0.35);
    animation: heroScrollDot 2.2s cubic-bezier(0.55, 0.05, 0.45, 0.95) infinite;
  }

  @keyframes heroScrollDot {
    0% {
      top: -14px;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      top: 56px;
      opacity: 0;
    }
  }
</style>
