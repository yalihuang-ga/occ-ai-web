---
/**
 * 樂齡數位 — validation-site recruitment page body.
 *
 * Deliberately server-rendered only (no React island, no framer-motion):
 * the audience is community-centre staff on older devices, and the page
 * doubles as living proof of the senior-friendly design claims it makes.
 * Local light-theme tokens live in the scoped <style> below so that the
 * site-wide dark `@theme` in global.css is untouched.
 */
import { useTranslations } from '../../i18n/utils';
import AgetechEventGallery from './AgetechEventGallery.astro';

const t = useTranslations('zh-TW');

const TEL_HREF = 'tel:+886978501017';
const OFFICE_TEL_HREF = 'tel:+886226588866;ext=6213';
const MAIL_HREF = 'mailto:yalihuang@gamania.com';

/**
 * 阿咪貓 mascot art, reused from the agetech-comic product itself so the
 * page previews the exact character seniors will meet. The source PNGs are
 * drawn on solid white. The hero blends that white into the page and shows
 * the full image; the contact card uses a small circular frame.
 */
const CAT = {
  smile: '/images/agetech/cat-smile.webp',
  normal2: '/images/agetech/cat-normal2.webp',
};

/**
 * Real product screenshots (cropped/re-encoded from the running app).
 * They are content, not decoration — each carries a descriptive alt —
 * and together they show the tap-first flow: the product deliberately
 * leads with big buttons rather than free speech input.
 */
const flowSteps = [
  {
    key: '1',
    title: t('agetech.flow.step1.title'),
    body: t('agetech.flow.step1.body'),
    shot: '/images/agetech/flow-1.webp',
    alt: t('agetech.flow.step1.alt'),
    width: 748,
    height: 398,
  },
  {
    key: '2',
    title: t('agetech.flow.step2.title'),
    body: t('agetech.flow.step2.body'),
    shot: '/images/agetech/flow-2.webp',
    alt: t('agetech.flow.step2.alt'),
    width: 707,
    height: 706,
  },
  {
    key: '3',
    title: t('agetech.flow.step3.title'),
    body: t('agetech.flow.step3.body'),
    shot: '/images/agetech/flow-3.webp',
    alt: t('agetech.flow.step3.alt'),
    width: 716,
    height: 758,
  },
  {
    key: '4',
    title: t('agetech.flow.step4.title'),
    body: t('agetech.flow.step4.body'),
    shot: '/images/agetech/flow-4.webp',
    alt: t('agetech.flow.step4.alt'),
    width: 744,
    height: 723,
  },
];

/**
 * Real AI-generated comics (re-encoded from the product's output).
 * Four different stories; the captions quote each comic's own title.
 */
const samples = [
  {
    src: '/images/agetech/sample-1.webp',
    caption: t('agetech.samples.item1.caption'),
    alt: t('agetech.samples.item1.alt'),
    width: 760,
    height: 932,
  },
  {
    src: '/images/agetech/sample-2.webp',
    caption: t('agetech.samples.item2.caption'),
    alt: t('agetech.samples.item2.alt'),
    width: 567,
    height: 695,
  },
  {
    src: '/images/agetech/sample-3.webp',
    caption: t('agetech.samples.item3.caption'),
    alt: t('agetech.samples.item3.alt'),
    width: 567,
    height: 695,
  },
  {
    src: '/images/agetech/sample-4.webp',
    caption: t('agetech.samples.item4.caption'),
    alt: t('agetech.samples.item4.alt'),
    width: 567,
    height: 695,
  },
];

const partnerProvides = [
  t('agetech.partner.yours.1'),
  t('agetech.partner.yours.2'),
  t('agetech.partner.yours.3'),
];

const weProvide = [
  t('agetech.partner.ours.1'),
  t('agetech.partner.ours.2'),
  t('agetech.partner.ours.3'),
  t('agetech.partner.ours.4'),
  t('agetech.partner.ours.5'),
];

const valueItems = [1, 2, 3, 4].map((n) => ({
  title: t(`agetech.value.${n}.title` as never),
  body: t(`agetech.value.${n}.body` as never),
}));

const a11yItems = [1, 2, 3, 4].map((n) => ({
  title: t(`agetech.a11y.${n}.title` as never),
  body: t(`agetech.a11y.${n}.body` as never),
}));

/**
 * Eligible districts: 109 年鄉鎮市區數位發展類型分類結果, clusters 2 and 3.
 * Source: _reference/agetech_screenshot/digital_development_group2_3.md
 */
const eligibleRegions: { county: string; group2: string[]; group3: string[] }[] = [
  { county: '臺北市', group2: ['萬華區'], group3: [] },
  { county: '新北市', group2: ['蘆洲區', '林口區', '鶯歌區'], group3: ['三芝區', '石門區', '金山區', '萬里區', '烏來區'] },
  { county: '基隆市', group2: ['七堵區', '中山區', '中正區', '仁愛區', '暖暖區'], group3: [] },
  { county: '桃園市', group2: ['大溪區', '大園區', '龜山區', '觀音區'], group3: ['新屋區'] },
  { county: '新竹縣', group2: ['竹東鎮', '芎林鄉', '新埔鎮', '寶山鄉'], group3: ['北埔鄉', '橫山鄉', '關西鎮'] },
  { county: '新竹市', group2: [], group3: [] },
  { county: '苗栗縣', group2: ['三義鄉', '公館鄉', '銅鑼鄉'], group3: ['三灣鄉', '大湖鄉', '西湖鄉', '卓蘭鎮', '南庄鄉', '後龍鎮', '苑裡鎮', '通霄鎮', '頭屋鄉', '造橋鄉'] },
  { county: '臺中市', group2: ['大甲區', '大肚區', '中區', '外埔區', '后里區', '清水區', '霧峰區', '梧棲區', '豐原區', '沙鹿區', '東區', '烏日區', '石岡區', '太平區'], group3: ['大安區', '新社區', '東勢區'] },
  { county: '彰化縣', group2: ['大村鄉', '北斗鎮', '永靖鄉', '伸港鄉', '秀水鄉', '和美鎮', '社頭鄉', '花壇鄉', '鹿港鎮', '溪湖鎮', '福興鄉', '線西鄉', '員林市', '埔心鄉'], group3: ['田尾鄉', '芳苑鄉', '芬園鄉', '埔鹽鄉', '溪州鄉', '田中鎮', '埤頭鄉', '二水鄉', '二林鎮'] },
  { county: '南投縣', group2: ['南投市', '埔里鎮', '草屯鎮'], group3: ['名間鄉', '竹山鎮', '魚池鄉', '集集鎮'] },
  { county: '雲林縣', group2: ['斗六市', '斗南鎮', '虎尾鎮', '麥寮鄉'], group3: ['土庫鎮', '大埤鄉', '北港鎮', '古坑鄉', '西螺鎮', '林內鄉', '莿桐鄉'] },
  { county: '嘉義縣', group2: ['太保市'], group3: ['大林鎮', '中埔鄉', '水上鄉', '朴子市', '民雄鄉', '阿里山鄉', '新港鄉'] },
  { county: '嘉義市', group2: [], group3: [] },
  { county: '臺南市', group2: ['仁德區', '官田區', '新化區', '新營區', '歸仁區', '安南區', '南區'], group3: ['下營區', '山上區', '六甲區', '麻豆區', '西港區', '柳營區', '學甲區', '鹽水區', '安定區', '佳里區'] },
  { county: '高雄市', group2: ['仁武區', '永安區', '大寮區', '新興區', '路竹區', '橋頭區', '燕巢區', '鹽埕區', '彌陀區'], group3: ['甲仙區', '茄萣區', '旗山區', '旗津區', '大社區', '林園區', '阿蓮區', '梓官區', '湖內區', '大樹區'] },
  { county: '屏東縣', group2: ['屏東市', '內埔鄉', '萬丹鄉', '潮州鎮'], group3: ['九如鄉', '竹田鄉', '長治鄉', '枋寮鄉', '林邊鄉', '南州鄉', '琉球鄉', '新園鄉', '萬巒鄉', '東港鎮', '麟洛鄉', '里港鄉'] },
  { county: '宜蘭縣', group2: ['五結鄉', '冬山鄉'], group3: ['三星鄉', '壯圍鄉', '員山鄉', '頭城鎮', '礁溪鄉', '蘇澳鎮'] },
  { county: '花蓮縣', group2: ['花蓮市', '吉安鄉', '新城鄉'], group3: ['玉里鎮', '光復鄉', '壽豐鄉'] },
  { county: '臺東縣', group2: ['臺東市'], group3: ['卑南鄉', '關山鎮', '綠島鄉'] },
  { county: '澎湖縣', group2: ['馬公市'], group3: ['湖西鄉', '白沙鄉'] },
  { county: '金門縣', group2: ['金城鎮', '金湖鎮', '金寧鄉'], group3: ['金沙鎮', '烈嶼鄉'] },
  { county: '連江縣', group2: ['北竿鄉', '東引鄉', '莒光鄉'], group3: [] },
];

const regionList = eligibleRegions
  .map((r) => ({ county: r.county, districts: [...r.group2, ...r.group3] }))
  .filter((r) => r.districts.length > 0);
---

<div class="ag-page">
  <a href="#ag-main" class="ag-skip">跳到主要內容</a>

  <main id="ag-main">
  {/* ============ Hero ============ */}
  <section class="ag-hero">
    <div class="ag-wrap ag-hero__inner">
      <div class="ag-hero__copy">
      <p class="ag-eyebrow">{t('agetech.hero.eyebrow')}</p>
      <h1 class="ag-h1">{t('agetech.hero.title')}</h1>
      <p class="ag-lead">{t('agetech.hero.lead')}</p>

      <p class="ag-seeking">{t('agetech.hero.seeking')}</p>

      <div class="ag-cta-row">
        <a href={TEL_HREF} class="ag-btn ag-btn--primary">
          <svg class="ag-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2A2 2 0 0 1 6.5 3Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {t('agetech.hero.cta.call')}
        </a>
        <a href={MAIL_HREF} class="ag-btn ag-btn--secondary">
          <svg class="ag-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"></rect>
            <path
              d="M3.5 6.5 12 13l8.5-6.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {t('agetech.hero.cta.mail')}
        </a>
      </div>
      </div>

      {/* Decorative mascot with a friendly opening line for seniors. */}
      <figure class="ag-mascot">
        <p class="ag-mascot__bubble">{t('agetech.hero.bubble')}</p>
        <img
          class="ag-mascot__img"
          src={CAT.smile}
          alt=""
          width="640"
          height="640"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  {/* ============ Product video ============ */}
  <section class="ag-video-section" aria-label="樂齡漫畫日記宣傳影片">
    <div class="ag-wrap">
      <video
        class="ag-video"
        controls
        playsinline
        preload="metadata"
        poster="/images/agetech/muztrix-ai-agetech-video-cover.png"
        aria-label="樂齡漫畫日記宣傳影片"
      >
        <source src="/video/muztrix-ai-agetech.mp4" type="video/mp4" />
        您的瀏覽器無法播放此影片。
        <a href="/video/muztrix-ai-agetech.mp4">開啟影片</a>
      </video>
    </div>
  </section>

  {/* ============ What seniors actually do ============ */}
  <section class="ag-section" aria-labelledby="ag-flow-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-flow-title">{t('agetech.flow.title')}</h2>
      <p class="ag-section-lead ag-highlight">{t('agetech.flow.lead')}</p>

      <ol class="ag-flow">
        {
          flowSteps.map((step) => (
            <li class="ag-flow__item">
              <div class="ag-flow__shot">
                <img
                  src={step.shot}
                  alt={step.alt}
                  width={step.width}
                  height={step.height}
                  loading="lazy"
                />
              </div>
              <div class="ag-flow__text">
                <h3 class="ag-h3">
                  <span class="ag-flow__num" aria-hidden="true">{step.key}</span>
                  {step.title}
                </h3>
                <p class="ag-body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ============ Comic samples ============ */}
  <section class="ag-section ag-section--tint" aria-labelledby="ag-samples-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-samples-title">{t('agetech.samples.title')}</h2>
      <p class="ag-section-lead ag-highlight">{t('agetech.samples.lead')}</p>

      <div class="ag-samples">
        {
          samples.map((sample) => (
            <figure class="ag-sample">
              <img
                class="ag-sample__img"
                src={sample.src}
                alt={sample.alt}
                width={sample.width}
                height={sample.height}
                loading="lazy"
              />
              <figcaption class="ag-sample__caption">{sample.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ Zero burden on the partner ============ */}
  <section class="ag-section" aria-labelledby="ag-partner-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-partner-title">{t('agetech.partner.title')}</h2>
      <p class="ag-section-lead ag-highlight">{t('agetech.partner.lead')}</p>

      <div class="ag-split">
        <div class="ag-split__col ag-split__col--yours">
          <h3 class="ag-h3">{t('agetech.partner.yours.title')}</h3>
          <ul class="ag-list">
            {partnerProvides.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="ag-split__col ag-split__col--ours">
          <h3 class="ag-h3">{t('agetech.partner.ours.title')}</h3>
          <ul class="ag-list ag-list--check">
            {weProvide.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <p class="ag-note ag-highlight ag-highlight--center">{t('agetech.partner.note')}</p>
    </div>
  </section>

  {/* ============ Value to the centre ============ */}
  <section class="ag-section ag-section--tint" aria-labelledby="ag-value-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-value-title">{t('agetech.value.title')}</h2>
      <div class="ag-cards">
        {
          valueItems.map((item) => (
            <div class="ag-card">
              <h3 class="ag-h3">{item.title}</h3>
              <p class="ag-body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ Who we are ============ */}
  <section class="ag-section" aria-labelledby="ag-about-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-about-title">{t('agetech.about.title')}</h2>
      <p class="ag-body ag-body--wide">{t('agetech.about.body1')}</p>
      <p class="ag-body ag-body--wide">{t('agetech.about.collaboration')}</p>
      <p class="ag-inline-links">
        <a href="https://www.gov.taipei/News_Content.aspx?n=F0DDAF49B89E9413&sms=72544237BBE4C5F6&s=C7FEA6370E24B30B" target="_blank" rel="noopener noreferrer">{t('agetech.about.link.news')}</a>
      </p>
      <AgetechEventGallery />
    </div>
  </section>

  {/* ============ Senior-friendly design & privacy ============ */}
  <section class="ag-section ag-section--tint" aria-labelledby="ag-a11y-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-a11y-title">{t('agetech.a11y.title')}</h2>
      <div class="ag-cards">
        {
          a11yItems.map((item) => (
            <div class="ag-card">
              <h3 class="ag-h3">{item.title}</h3>
              <p class="ag-body">{item.body}</p>
            </div>
          ))
        }
      </div>
      <p class="ag-note ag-note--accent">{t('agetech.a11y.note')}</p>
    </div>
  </section>

  {/* ============ Contact ============ */}
  <section class="ag-section ag-contact" id="contact" aria-labelledby="ag-contact-title">
    <div class="ag-wrap">
      <h2 class="ag-h2" id="ag-contact-title">{t('agetech.contact.title')}</h2>

      <div class="ag-contact__card">
        <img
          class="ag-contact__cat"
          src={CAT.normal2}
          alt=""
          width="640"
          height="640"
          loading="lazy"
        />
        <p class="ag-contact__who">
          <span class="ag-contact__label">{t('agetech.contact.name.label')}</span>
          <strong class="ag-contact__name">{t('agetech.contact.name')}</strong>
          <span class="ag-contact__role">{t('agetech.contact.role')}</span>
        </p>

        <a href={TEL_HREF} class="ag-contact__row">
          <span class="ag-contact__label">{t('agetech.contact.phone.label')}</span>
          <span class="ag-contact__value">{t('agetech.contact.phone')}</span>
        </a>

        <a href={OFFICE_TEL_HREF} class="ag-contact__row">
          <span class="ag-contact__label">{t('agetech.contact.office.label')}</span>
          <span class="ag-contact__value ag-contact__value--office">{t('agetech.contact.office')}</span>
        </a>

        <a href={MAIL_HREF} class="ag-contact__row">
          <span class="ag-contact__label">{t('agetech.contact.mail.label')}</span>
          <span class="ag-contact__value ag-contact__value--mail">
            {t('agetech.contact.mail')}
          </span>
        </a>

        <div class="ag-contact__line">
          <span class="ag-contact__label">{t('agetech.contact.line.label')}</span>
          <div class="ag-contact__line-content">
            <img
              class="ag-contact__line-qr"
              src="/images/agetech/contact-line-qr.jpg"
              alt={t('agetech.contact.line.alt')}
              width="900"
              height="900"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      {/* Eligible districts, so referrers can check a site before passing it on. */}
      <details class="ag-regions" id="regions">
        <summary class="ag-regions__summary">
          <h3 class="ag-regions__title">{t('agetech.regions.title')}</h3>
          <span class="ag-regions__hint" aria-hidden="true">
            <span class="ag-regions__hint-open">展開</span>
            <span class="ag-regions__hint-close">收合</span>
            <svg class="ag-regions__chevron" viewBox="0 0 24 24">
              <path
                d="m6 9 6 6 6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </summary>

        <ul class="ag-regions__list">
          {
            regionList.map((region) => (
              <li class="ag-region">
                <strong class="ag-region__county">{region.county}</strong>
                <span class="ag-region__names">{region.districts.join('、')}</span>
              </li>
            ))
          }
        </ul>
      </details>

    </div>
  </section>

  </main>

  {/* Page footer — a sibling of <main>, not a section footer inside it. */}
  <footer class="ag-footer">
    <div class="ag-wrap">
      <a href="/" class="ag-footer__back">{t('agetech.footer.back')}</a>
      <p class="ag-footer__legal">© {new Date().getFullYear()} Muztrix · Gamania Original Content Center</p>
    </div>
  </footer>
</div>

<script>
  // Region list starts collapsed; open it for a direct #regions link and for printing.
  const regions = document.getElementById('regions') as HTMLDetailsElement | null;
  if (regions) {
    const openOnHash = () => {
      if (location.hash === '#regions') regions.open = true;
    };
    openOnHash();
    window.addEventListener('hashchange', openOnHash);
    window.addEventListener('beforeprint', () => {
      regions.open = true;
    });
  }
</script>

{/* The site-wide dark body styling lives in BaseLayout; this page is light.
    Unlayered rules here outrank the Tailwind utility layer on body. */}
<style is:global>
  body {
    background: #fdfbf7;
    color: #1a1a1a;
  }
</style>

<style>
  /* ============================================================
     Local light-theme tokens. Contrast against #fdfbf7:
       --ag-ink       #1a1a1a  16.8:1
       --ag-ink-2     #4a4540   9.2:1
       --ag-accent    #c23f00   5.1:1  (and 5.2:1 for white-on-accent)
     ============================================================ */
  .ag-page {
    --ag-bg: #fdfbf7;
    --ag-bg-tint: #f6f1e8;
    --ag-card: #ffffff;
    --ag-ink: #1a1a1a;
    --ag-ink-2: #4a4540;
