---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import Solutions from './sections/Solutions.astro';
import IndustrySolutions from './sections/IndustrySolutions.astro';
import EngineCapabilities from './sections/EngineCapabilities.astro';
import About from './sections/About.astro';
import ProductCards from './sections/ProductCards.astro';
import CTAFooter from './sections/CTAFooter.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const seo = {
  'zh-TW': {
    title: 'Muztrix | 遊戲開發工藝 × AI — 遊戲、醫療、餐飲、樂齡的互動引擎',
    description:
      '橘子集團原創內容中心以三十年遊戲開發經驗打造的 AI 互動引擎。從 AI 遊戲開發、AI 漫畫，到醫療互動訓練、餐飲影像分析與樂齡應用——場景生成、角色互動、遊戲化機制，地端部署可落地。',
  },
  en: {
    title: 'Muztrix | Game Craft × AI — Interactive Engines for Games, Healthcare, F&B & Senior Care',
    description:
      'An AI interaction engine built on thirty years of game development by Gamania Original Content Center. From AI game dev and comics to medical training, F&B vision analytics, and senior care — scene generation, character interaction, and gamification, deployable on-premises.',
  },
  ja: {
    title: 'Muztrix | ゲーム開発工芸 × AI — ゲーム・医療・飲食・シニア向けインタラクティブエンジン',
    description:
      'ガマニアグループ オリジナルコンテンツセンターが三十年のゲーム開発経験で築いたAIインタラクションエンジン。AIゲーム開発・AIコミックから、医療トレーニング、飲食店向け映像分析、シニア向けサービスまで——シーン生成・キャラクター対話・ゲーミフィケーションをオンプレミスで。',
  },
};

const { title, description } = seo[lang];

const SITE = 'https://ai.gamaniaocc.com';

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: lang === 'zh-TW' ? `${SITE}/` : `${SITE}/${lang}/`,
  inLanguage: lang === 'zh-TW' ? 'zh-Hant-TW' : lang === 'ja' ? 'ja-JP' : 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Muztrix',
    url: SITE,
  },
  about: {
    '@type': 'Thing',
    name: 'AI interactive engine — game development, healthcare training, F&B vision analytics, senior care',
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head-extras">
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
  </Fragment>

  <div class="mx-root">
    <Header lang={lang} />
    <Hero lang={lang} />
    <ProductCards lang={lang} />
    <Solutions lang={lang} />
    <IndustrySolutions lang={lang} />
    <EngineCapabilities lang={lang} />
    <About lang={lang} />
    <CTAFooter lang={lang} />
  </div>
</BaseLayout>

<style>
  /* Each artboard / page root becomes the container query target */
  .mx-root {
    container-type: inline-size;
    container-name: page;
  }
</style>
