---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import Solutions from './sections/Solutions.astro';
import About from './sections/About.astro';
import ProductCards from './sections/ProductCards.astro';
import ComputexBanner from './sections/ComputexBanner.astro';
import WhyWarmAI from './sections/WhyWarmAI.astro';
import HowWarmAI from './sections/HowWarmAI.astro';
import CTAFooter from './sections/CTAFooter.astro';
import type { Lang } from '../i18n/ui';
import { COMPUTEX_LIVE } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const seo = {
  'zh-TW': {
    title: 'Muztrix | AI 虛擬人、AI 漫畫、AI 遊戲開發整合方案',
    description: '橘子集團原創內容中心打造的 AI 內容生產平台。整合多模態虛擬人、AI 漫畫工作室、AI 遊戲開發工具，協助品牌打造具備溫度的虛擬互動體驗。',
  },
  en: {
    title: 'Muztrix | AI Virtual Human, Comic Studio & Game Development Platform',
    description: 'AI-powered content platform by Gamania Original Content Center. Multimodal virtual humans, AI comic studio, and game development tools — helping brands build human-centered virtual experiences.',
  },
  ja: {
    title: 'Muztrix | AIバーチャルヒューマン・AIコミック・AIゲーム開発の統合プラットフォーム',
    description: 'ガマニアグループ オリジナルコンテンツセンターが提供するAIコンテンツ制作プラットフォーム。マルチモーダル・バーチャルヒューマン、AIコミックスタジオ、AIゲーム開発ツールでブランドの温度感ある仮想体験を実現します。',
  },
};

const { title, description } = seo[lang];

const SITE = 'https://ai.gamaniaocc.org';

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: lang === 'zh-TW' ? `${SITE}/` : `${SITE}/${lang}/`,
  inLanguage: lang === 'zh-TW' ? 'zh-Hant-TW' : lang === 'ja' ? 'ja-JP' : 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Muztrix',
    url: SITE,
  },
  about: {
    '@type': 'Thing',
    name: 'Warm AI — human-centered virtual interaction',
  },
};

const eventSchema = COMPUTEX_LIVE
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: 'Muztrix at COMPUTEX 2026',
      description:
        lang === 'zh-TW'
          ? '原創中心 AI 於 COMPUTEX 2026 展示「讓溫暖延續」的虛擬互動體驗，邀請品牌成為第一個共同驗證的夥伴。'
          : lang === 'ja'
            ? 'ガマニア原創中心AIは、COMPUTEX 2026にて「温もりを続ける」バーチャル体験を出展します。'
            : 'Gamania OCC AI showcases its "Keep warmth alive" virtual interaction at COMPUTEX 2026 — looking for a first pilot partner.',
      startDate: '2026-06-02',
      endDate: '2026-06-05',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Taipei Nangang Exhibition Hall',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'No. 1, Jingmao 2nd Rd.',
          addressLocality: 'Nangang District',
          addressRegion: 'Taipei City',
          addressCountry: 'TW',
        },
      },
      organizer: {
        '@type': 'Organization',
        name: 'Muztrix',
        url: SITE,
      },
    }
  : null;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head-extras">
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
    {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  </Fragment>

  <div class="mx-root">
    {COMPUTEX_LIVE && <ComputexBanner lang={lang} />}
    <Header lang={lang} />
    <Hero lang={lang} />
    <ProductCards lang={lang} />
    <WhyWarmAI lang={lang} />
    <HowWarmAI lang={lang} />
    <Solutions lang={lang} />
    <About lang={lang} />
    <CTAFooter lang={lang} />
  </div>
</BaseLayout>

<style>
  /* Each artboard / page root becomes the container query target */
  .mx-root {
    container-type: inline-size;
    container-name: page;
  }
</style>
