---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../sections/Header.astro';
import VHHero from '../sections/VHHero.astro';
import VirtualHuman from '../sections/VirtualHuman.astro';
import WhyWarmAI from '../sections/WhyWarmAI.astro';
import HowWarmAI from '../sections/HowWarmAI.astro';
import CTAFooter from '../sections/CTAFooter.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const seo = {
  'zh-TW': {
    title: 'AI 虛擬人 | 多模態感知與自適應人設 | Muztrix',
    description: '虛擬接待員、AI 導購、品牌 IP 代言人。多模態感知顧客特徵，串接會員資料，動態調校人設，讓每一次互動都更有溫度。',
  },
  en: {
    title: 'AI Virtual Human | Multimodal Perception & Adaptive Persona | Muztrix',
    description: 'Virtual receptionist, AI sales assistant, brand IP avatar. Multimodal perception, member-data sync, and adaptive persona for warmer customer interactions.',
  },
  ja: {
    title: 'AIバーチャルヒューマン | マルチモーダル感知と適応型ペルソナ | Muztrix',
    description: 'バーチャル受付、AI接客、ブランドIPアバター。マルチモーダル感知と会員データ連携、動的人格チューニングで、温度感のある対話体験を提供します。',
  },
};

const { title, description } = seo[lang];

const SITE = 'https://ai.gamaniaocc.org';

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url:
    lang === 'zh-TW'
      ? `${SITE}/virtual-human/`
      : `${SITE}/${lang}/virtual-human/`,
  inLanguage: lang === 'zh-TW' ? 'zh-Hant-TW' : lang === 'ja' ? 'ja-JP' : 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Muztrix',
    url: SITE,
  },
  about: {
    '@type': 'Thing',
    name: 'Warm AI — human-centered virtual interaction',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  preloadDefaultHeroImages={false}
  preloadHeroImage="/images/guoya/guoya_mixed_clean.webp"
>
  <Fragment slot="head-extras">
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
  </Fragment>

  <div class="mx-root">
    <Header lang={lang} />
    <VHHero lang={lang} />
    <VirtualHuman lang={lang} />
    <WhyWarmAI lang={lang} />
    <HowWarmAI lang={lang} />
    <CTAFooter lang={lang} />
  </div>
</BaseLayout>

<style>
  .mx-root {
    container-type: inline-size;
    container-name: page;
  }
</style>
