---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getLocaleUrlsForPathname } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('site.title'), description = t('site.description') } =
  Astro.props;

// Analytics
const GA_ID = 'G-T1VMEDD4N5';

// SEO — i18n equivalents (hreflang)
const SITE = 'https://ai.gamaniaocc.org';
const localeUrls = getLocaleUrlsForPathname(Astro.url.pathname);
const hreflangMap: Record<Lang, string> = {
  'zh-TW': 'zh-Hant-TW',
  en: 'en',
  ja: 'ja-JP',
};
const ogLocaleMap: Record<Lang, string> = {
  'zh-TW': 'zh_TW',
  en: 'en_US',
  ja: 'ja_JP',
};

const canonicalUrl = `${SITE}${localeUrls[lang]}`;
const ogImageUrl = `${SITE}/og-image.png`;
---

<!doctype html>
<html lang={hreflangMap[lang]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t('site.keywords')} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Search Console verification -->
    <meta
      name="google-site-verification"
      content="Z9CWY4f2rifiewbQ8F2bKwxqyhSAZV2NiCJXFyro0Zk"
    />

    <!-- hreflang for multilingual SEO -->
    {
      (Object.keys(localeUrls) as Lang[]).map((code) => (
        <link
          rel="alternate"
          hreflang={hreflangMap[code]}
          href={`${SITE}${localeUrls[code]}`}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${SITE}${localeUrls['zh-TW']}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muztrix" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    {
      (Object.keys(ogLocaleMap) as Lang[])
        .filter((c) => c !== lang)
        .map((c) => (
          <meta property="og:locale:alternate" content={ogLocaleMap[c]} />
        ))
    }

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />

    <!-- Theme color (mobile browser chrome) -->
    <meta name="theme-color" content="#0e0b08" />

    <!-- Preconnect — reduce handshake latency for critical origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Preload hero images for fast LCP — responsive: mobile gets smaller file -->
    <link rel="preload" as="image" href="/images/miyaki-full-mobile.webp" fetchpriority="high" media="(max-width: 767px)" />
    <link rel="preload" as="image" href="/images/miyaki-full.webp" fetchpriority="high" media="(min-width: 768px)" />

    <!-- Fonts: minimal weights, async (non-render-blocking) load with display=swap -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@200;300;500;600;700&family=Inter:wght@400;500;600;700&family=Noto+Serif+TC:wght@400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@200;300;500;600;700&family=Inter:wght@400;500;600;700&family=Noto+Serif+TC:wght@400&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Epilogue:wght@200;300;500;600;700&family=Inter:wght@400;500;600;700&family=Noto+Serif+TC:wght@400&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Google Analytics 4 (production only) -->
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script
            is:inline
            set:html={`
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', '${GA_ID}');
            `}
          />
        </>
      )
    }

    <!-- JSON-LD Organization schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Muztrix',
        legalName: 'Gamania Digital Entertainment Co., Ltd. — Original Content Center',
        url: SITE,
        logo: `${SITE}/android-chrome-512x512.png`,
        image: ogImageUrl,
        description: t('site.description'),
        founder: { '@type': 'Organization', name: 'Gamania' },
        foundingDate: '1995',
        sameAs: ['https://mangacanvas.gamaniaocc.org/'],
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'No. 111, Ruihu Street',
          addressLocality: 'Neihu District',
          addressRegion: 'Taipei City',
          addressCountry: 'TW',
        },
        contactPoint: [
          {
            '@type': 'ContactPoint',
            email: 'mazzchou@gamania.com',
            contactType: 'technical support',
          },
          {
            '@type': 'ContactPoint',
            email: 'yalihuang@gamania.com',
            contactType: 'customer support',
          },
        ],
      })}
    />
  </head>
  <body class="bg-background text-on-background font-body">
    <slot />
    <script is:inline>
      document.addEventListener('contextmenu', function(e) {
        if (e.target.tagName === 'IMG') e.preventDefault();
      });
      document.addEventListener('dragstart', function(e) {
        if (e.target.tagName === 'IMG') e.preventDefault();
      });
    </script>
  </body>
</html>
